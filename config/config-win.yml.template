# 秘密情報暗号化鍵は data/key/secret.key へ自動生成・保存されます (config.yml での指定は廃止)。
# 旧バージョンで secretKey を設定していた場合は、初回起動時にその値が鍵ファイルへ移行されます。

# データ放送 (BML) 配信 (featureFlags.dataBroadcasting: true の場合のみ有効)。
# クライアントは WebSocket (/api/dataBroadcasting/ws) でカルーセルのモジュール等を受け取ります。
# dataBroadcasting:
#     # WebSocket 経由のデータ放送ストリーム同時本数上限。既定 4。
#     # 上限を超えると最も古いストリームを閉じて新しい要求を受け付けます
#     maxStreams: 4

# 機能フラグ。**未指定の項目は有効**として扱われます。
# 止めたい機能だけ false を書いてください (featureFlags 自体を省略すると全機能が有効)。
# featureFlags:
#     watchHistory: true
#     notifications: true
#     dashboard: true
#     systemSettings: true
#     seriesLibrary: true
#     metadataProviders: true
#     programSeriesMapping: true
#     annictSync: true
#     nextUpPanel: true
#     externalFileImport: true
#     advancedSearch: true
#     updateNotification: true
#     dataBroadcasting: true

# 録画開始のリトライ方針。
# 前の番組が「放送時刻未定」(ARIB の duration = 0xFFFFFF) で延長していると、
# 予約した番組の開始が遅れます。Mirakurun は EIT[p/f] で対象の番組が始まるまで
# データを流さないため、EPGStation はその間待つ必要があります。
# チューナー異常とは別枠で数えるので、延長待ちが異常時の再試行回数を食い潰しません。
# recording:
#     # 番組開始を待つ上限 (ms)。既定 3 時間。0 で待たない
#     startWaitLimitMs: 10800000
#     # 開始待ち中の再試行間隔 (ms)。既定 60000
#     startWaitIntervalMs: 60000
#     # ストリーム開始後、最初のデータを待つ時間 (ms)。既定 5000
#     firstDataTimeoutMs: 5000
#     # チューナー異常時の再試行 (短間隔 → 長間隔)
#     errorFastRetryCount: 3
#     errorFastRetryIntervalMs: 5000
#     errorRetryCount: 27
#     errorRetryIntervalMs: 60000
#     # 予約した番組が EIT[p/f] present になるまで録画を始めない (既定 true)。
#     # 前番組の延長中に録画が始まって前番組が録れてしまうのを防ぎます。
#     # false にすると従来どおりストリームの最初のデータで録画を開始します
#     startGateEnabled: true
#     # EIT[p/f] を読めないまま録画を開始するまでの時間 (ms)。既定 60000
#     startGateTimeoutMs: 60000
#     # 放送中の番組の開始時刻が予約開始時刻よりこれ以上前なら「前の番組」とみなす (ms)。既定 120000
#     startGateStartMarginMs: 120000

# Web UI / API のログイン認証。**既定で有効**です。
# 初回アクセス時に管理ユーザーの作成画面が表示され、最初に登録した人が
# システム管理者になります。
# リバースプロキシ側で認証している等で不要な場合は enabled: false を書いてください。
# auth:
#     enabled: false
#     # セッションの有効期間 (ms)。既定 30 日
#     sessionTtlMs: 2592000000
#     # 外部プレイヤー (VLC / Infuse) や IPTV クライアント用アクセストークンの有効期間 (ms)。既定 365 日
#     # これらは Cookie を送れないため、動画 URL のクエリに付くトークンで認証します
#     mediaTokenTtlMs: 31536000000
#     # ログインしていない利用者にも一般ユーザーと同じ操作を許可する。**既定で許可**。
#     # 視聴・予約・録画閲覧はログイン不要で行える一方、
#     # 設定変更・ユーザー管理・バージョン更新はシステム管理者としてのログインが必要です。
#     # インターネットに公開している場合は false にしてください
#     allowAnonymous: false
#     # 2 人目以降のサインアップ (SSO での新規ユーザー作成) を許可するか。既定 true。
#     # 最初にサインアップした人が自動でシステム管理者になり、以降は一般権限になります。
#     # インターネットに公開している場合、false にして管理者が招待する運用を推奨します
#     allowSignUp: true
#     # Google / GitHub の SSO。ログイン前に必要なため config.yml に書きます。
#     # コールバック URL (プロバイダ側に登録する値) の既定は
#     #   <アクセス元 URL>/api/auth/oauth/<google|github>/callback
#     # です。リバースプロキシ配下などで自動判定が合わない場合のみ redirectUri を明示してください。
#     providers:
#         google:
#             clientId: 'xxxxxxxx.apps.googleusercontent.com'
#             clientSecret: 'xxxxxxxx'
#             # redirectUri: 'https://epg.example.com/api/auth/oauth/google/callback'
#         github:
#             clientId: 'Iv1.xxxxxxxx'
#             clientSecret: 'xxxxxxxx'
#             # redirectUri: 'https://epg.example.com/api/auth/oauth/github/callback'

# 新しいバージョンが公開されたときに Web UI で知らせる (featureFlags.updateNotification 有効時のみ)。
# updateChecker:
#     # 監視するリポジトリ ('owner/repo' 形式、既定 stuayu/EPGStation)
#     repository: 'stuayu/EPGStation'
#     # 「最新の開発版へ更新」で追従するブランチ (既定 main)
#     branch: 'main'
#     # チェック間隔 (ms、既定 6 時間)。0 以下でチェックを止める
#     checkIntervalMs: 21600000
#     # プレリリース (rc / beta / alpha) も通知するか (既定 true。UI では色を変えて区別する)
#     includePrerelease: true

# しょぼいカレンダー ChID ⇄ Mirakurun networkId/serviceId のマッピング表 (JSON) のパス。
# 省略時は同梱の初期データ (主要地上波キー局のみ) を使う。指定したファイルの内容は同梱データを
# 上書き/追加する (featureFlags.metadataProviders: true の場合のみ使用される)
# metadataChannelMappingPath: '/path/to/syobocal-channel-map.json'

# チャンネルマッピング表・エイリアス辞書等の共有静的データを GitHub 等から自動取得する URL (§5.1)。
# 起動時 + metadataSharedDataUpdateIntervalMs 間隔で取得し、ローカル (data/metadataSharedData.json) に
# キャッシュする。オフライン/取得失敗時は前回キャッシュ→同梱データの順にフォールバックする
# (featureFlags.metadataProviders: true の場合のみ使用される)
# metadataSharedDataUrl: 'https://raw.githubusercontent.com/<user>/<repo>/main/syobocal-shared-data.json'
# 自動更新間隔 (ms)。省略時 24 時間。0 を指定すると起動時取得のみで定期更新を行わない
# metadataSharedDataUpdateIntervalMs: 86400000

# 外部メタデータプロバイダーの既定値 (設定画面 (DB) に値がある場合はそちらが優先される)
# (featureFlags.metadataProviders: true の場合のみ使用される)
# metadataDefaults:
#     syobocal:
#         enabled: true
#         # しょぼいカレンダーのアニメ作品タイトル辞書 (シリーズ自動マッピングの照合辞書) の
#         # 自動同期間隔 (ms)。省略時 24 時間。0 を指定すると自動同期を行わない
#         titleSyncIntervalMs: 86400000
#     wikidata:
#         # 全ジャンルのテレビ番組辞書 (Wikidata) を取り込むか (既定 true)。
#         # しょぼいカレンダー / Annict がアニメ専門なのに対し、ドラマ・バラエティ・情報番組・
#         # ニュース、さらにローカル局の番組まで収録している (約 4 万件)。API キー不要
#         enabled: true
#         # 辞書の自動同期間隔 (ms)。省略時 7 日。0 を指定すると自動同期を行わない
#         syncIntervalMs: 604800000
#     annict:
#         enabled: false
#         # Annict の作品辞書 (英題・ローマ字・syobocalTid 対応表) の自動同期間隔 (ms)。
#         # 省略時 7 日。0 を指定すると自動同期を行わない。Annict はアクセストークンが必須のため、
#         # 設定画面でトークンを登録していない場合は取得されない
#         workSyncIntervalMs: 604800000
#     cacheTtlMs: 86400000
#     # 外部サービスのエンドポイント URL。Cloudflare 等のキャッシュ/プロキシを手前に置く場合に差し替える。
#     # 設定画面 (サーバー設定 > 連携) からも変更でき、そちらが優先される。
#     # プロキシは元サービスと同じパス・クエリ・レスポンス形式をそのまま返すこと
#     endpoints:
#         syobocal: 'https://cal.syoboi.jp/db.php'
#         annict: 'https://api.annict.com/graphql'
#         wikidata: 'https://query.wikidata.org/sparql'
#         fxtwitter: 'https://api.fxtwitter.com/'
#         # 共有静的データ URL (metadataSharedDataUrl と同義、こちらが優先)
#         sharedData: ''

# シリーズ自動マッピングの LLM フォールバック (featureFlags.seriesLibrary: true の場合のみ有効)。
# 作品辞書 (しょぼいカレンダー + Annict) で確定できなかったものだけを OpenAI 互換 API へ渡し、
# 抽出された作品名で辞書を引き直す。url と model の両方を指定した場合のみ有効になる。
# 抽出結果は必ず辞書で検証されるため、LLM の誤生成単体で誤リンクには至らない。
# 対象は (1) 録画単位: 辞書で引けなかった録画タイトル (2) シリーズ単位: 辞書で引けず
# syobocalTid / annictId が両方とも空のシリーズ (メタデータ再取得の実行時)
# seriesLlm:
#     # OpenAI 互換 Chat Completions API のベース URL (Ollama: http://localhost:11434/v1)
#     url: 'http://localhost:11434/v1'
#     # モデル名 (日本語に強いモデルを推奨。例: qwen2.5:7b-instruct)
#     model: 'qwen2.5:7b-instruct'
#     # API キー (ローカル LLM では通常不要)
#     # apiKey: ''
#     # リクエストタイムアウト (ms)。省略時 30000
#     # timeoutMs: 30000
#     # リクエスト間隔の下限 (ms)。省略時 0 (無制限)
#     # minIntervalMs: 0
#     # 応答の上限トークン数。省略時 2000。
#     # OpenRouter のフリーモデルはほぼ reasoning 系で、本文の前に思考へトークンを使う。
#     # 小さすぎると content が空のまま finish_reason: length で切れるが、その場合は
#     # 自動で 4 倍ずつ引き上げて再試行する (成功した値は以後の既定として使われる) ため通常は指定不要
#     # maxTokens: 2000
#     # 自動引き上げの上限。省略時 16000。これを超えても本文が出ない場合は失敗として扱う
#     # maxTokensLimit: 16000
#
# OpenRouter のフリーモデルを使う場合の例 (分あたり上限があるため minIntervalMs は必須と考えてよい)。
# 思考過程を本文に混ぜる reasoning 系モデルは JSON 抽出に失敗しやすいので instruct 系を選ぶこと
# seriesLlm:
#     url: 'https://openrouter.ai/api/v1'
#     model: 'inclusionai/ling-3.0-flash:free'
#     apiKey: 'sk-or-v1-xxxxxxxx'
#     minIntervalMs: 3500
#
# 動作確認済みの組み合わせ (2026-07 時点): inclusionai/ling-3.0-flash:free が
# 抽出精度・応答速度 (2〜6 秒) ともに良好。openai/gpt-oss-20b:free も可。
# nvidia/nemotron-3-ultra-550b-a55b:free は書式指示に従わないことがあり非推奨。
# なお OpenRouter のフリーモデルはほぼ reasoning 系なので maxTokens は既定 (2000) のままにすること

# サーバー起動時のシリーズ照合パイプライン (featureFlags.seriesLibrary: true の場合は既定で自動実行される)。
# 起動 7 分後に作品辞書 (しょぼいカレンダー + Annict) の自動同期の完了を待ち、
# シリーズ未リンクの録画だけを先頭から再照合する (リンク済み・手動ロック済みの録画には触れない)
# seriesStartup:
#     # false で起動時の自動実行を止める (既定 true)
#     enable: true
#     # true: 未リンク録画を毎回先頭から再照合 / false: 前回の続きから新規分のみ (既定 true)
#     rescanUnlinked: true
#     # 起動からパイプライン開始までの待機 (ms)。既定 420000 (7 分)
#     delayMs: 420000
#     # 辞書同期の完了待ちの上限 (ms)。既定 1800000 (30 分)
#     dictionaryWaitMs: 1800000

