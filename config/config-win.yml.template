port: 8888
# mirakurunPath は named pipe, http, https の URL が指定可能
# https 例: mirakurunPath: https://mirakurun.example.com
mirakurunPath: http://localhost:40772
# mirakurun の API エンドポイントのベースパス (省略時 /api)
# mirakurunAPIPath: /api

# dbtype: sqlite
# sqlite:
#   extensions:
#     - '/hoge/regexp.dylib'
#   regexp: true

dbtype: mysql
mysql:
    host: localhost
    port: 3306
    user: epgstation
    password: epgstation
    database: epgstation
    charset: utf8mb4

# 囲み文字を置換するか
needToReplaceEnclosingCharacters: true

apiServers:
    - http://localhost:8888
    - http://192.168.2.110:8888

epgUpdateIntervalTime: 10

conflictPriority: 1
recPriority: 2
isEnabledDropCheck: true

recordedFormat: '%YEAR%年%MONTH%月%DAY%日%HOUR%時%MIN%分%SEC%秒-%HALF_WIDTH_TITLE%_%HALF_WIDTH_CHNAME%'
recordedFileExtension: .m2ts
recorded:
    - name: recorded
      path: '%ROOT%/recorded'

# 外部録画ファイル (EDCB 等) の取り込みを許可するディレクトリ (featureFlags.externalFileImport: true の場合のみ有効)
# 未設定 (コメントアウトのまま) だと取り込み機能自体が無効になる
# importDirs:
#     - name: edcb
#       path: 'D:\EDCB\Recorded'
# importDefaultMode: register # register: 元ファイルを移動せず登録のみ行う / move: 録画ディレクトリへ移動する
# importFileNamePatterns: [] # EDCB ファイル名推定用のカスタム正規表現 (named capture group: year,month,day,hour,min,sec,name,channel)
# importWatch: false # true にすると importDirs を定期的に監視し新規ファイルを自動取り込みする
# importWatchIntervalSec: 300

thumbnail: '%ROOT%/thumbnail'
thumbnailSize: 480x270
thumbnailPosition: 5

ffmpeg: 'C:\rec\ffmpeg\bin\ffmpeg.exe'
ffprobe: 'C:\rec\ffmpeg\bin\ffprobe.exe'

# tsreadex の実行ファイルパス (ライブ HLS の cmd で %TSREADEX% を使う場合に指定、省略時は PATH 上の tsreadex)
# tsreadex: /usr/local/bin/tsreadex

# 録画ファイルのバックグラウンドエンコード上限
encodeProcessNum: 4
# ライブ視聴・録画再生ストリーミングの上限（encodeProcessNum とは別枠）
streamProcessNum: 4
concurrentEncodeNum: 1
encode:
    - name: HEVC_CMカット
      cmd: 'C:\Windows\System32\cmd.exe /C %ROOT%/config/amatsukaze_addtask.bat 自動選択_qsv'
      suffix: .mp4
      rate: 4.0

    - name: H264_CMカット
      cmd: 'C:\Windows\System32\cmd.exe /C %ROOT%/config/amatsukaze_addtask.bat QSVEnc_H264'
      suffix: .mp4
      rate: 4.0

    - name: H.264
      cmd: '%NODE% %ROOT%/config/enc.js'
      suffix: .mp4
      rate: 4.0

# encode[].id: プリセットの識別子 (省略時は name がそのまま識別子として使われる)。
# name はプリセットの表示名であり、id を省略していると name のリネームが録画予約や
# クライアントに保存済みの設定を無効にしてしまうため、運用中に name を変更する可能性がある場合は
# id を明示的に指定することを推奨する。
# video / audio はクライアント表示用の参考情報 (実際のエンコード処理は cmd が担う)。
# encode:
#     - id: h264-1080p
#       name: H.264 (1080p)
#       cmd: '%NODE% %ROOT%/config/enc.js'
#       suffix: .mp4
#       rate: 4.0
#       video:
#           codec: libx264
#           height: 1080
#           bitrate: 3000
#       audio:
#           codec: aac
#           bitrate: 192

encodingFinishCommand: 'C:\Windows\System32\cmd.exe /C node C:\rec\EPGStation\config\update_thumbnail.js'

urlscheme:
    m2ts:
        ios: vlc-x-callback://x-callback-url/stream?url=PROTOCOL://ADDRESS
        android: intent://ADDRESS#Intent;package=org.videolan.vlc;type=video;scheme=PROTOCOL;end
    video:
        ios: infuse://x-callback-url/play?url=PROTOCOL://ADDRESS
        android: intent://ADDRESS#Intent;package=com.mxtech.videoplayer.ad;type=video;scheme=PROTOCOL;end
    download:
        ios: vlc-x-callback://x-callback-url/download?url=PROTOCOL://ADDRESS&filename=FILENAME

stream:
    live:
        ts:
            m2ts:
                - name: 1080p
                  cmd:
                      '%FFMPEG% -re -dual_mono_mode main -i pipe:0 -sn -threads 0 -c:a aac -ar 48000 -b:a 192k -ac 2
                      -c:v libx264 -vf yadif,scale=-2:1080 -b:v 3000k -preset veryfast -y -f mpegts pipe:1'
                - name: 720p
                  cmd:
                      '%FFMPEG% -re -dual_mono_mode main -i pipe:0 -sn -threads 0 -c:a aac -ar 48000 -b:a 192k -ac 2
                      -c:v libx264 -vf yadif,scale=-2:720 -b:v 3000k -preset veryfast -y -f mpegts pipe:1'
                - name: 480p
                  cmd:
                      '%FFMPEG% -re -dual_mono_mode main -i pipe:0 -sn -threads 0 -c:a aac -ar 48000 -b:a 128k -ac 2
                      -c:v libx264 -vf yadif,scale=-2:480 -b:v 1500k -preset veryfast -y -f mpegts pipe:1'
                - name: 無変換

            m2tsll:
                - name: 1080p
                  cmd:
                      '%FFMPEG% -dual_mono_mode main -f mpegts -analyzeduration 500000 -i pipe:0 -map 0 -c:s copy -c:d
                      copy -ignore_unknown -fflags nobuffer -flags low_delay -max_delay 250000 -max_interleave_delta 1
                      -threads 0 -c:a aac -ar 48000 -b:a 192k -ac 2 -c:v libx264 -flags +cgop -vf yadif,scale=-2:1080
                      -b:v 3000k -preset veryfast -y -f mpegts pipe:1'
                - name: 720p
                  cmd:
                      '%FFMPEG% -dual_mono_mode main -f mpegts -analyzeduration 500000 -i pipe:0 -map 0 -c:s copy -c:d
                      copy -ignore_unknown -fflags nobuffer -flags low_delay -max_delay 250000 -max_interleave_delta 1
                      -threads 0 -c:a aac -ar 48000 -b:a 192k -ac 2 -c:v libx264 -flags +cgop -vf yadif,scale=-2:720
                      -b:v 3000k -preset veryfast -y -f mpegts pipe:1'
                - name: 480p
                  cmd:
                      '%FFMPEG% -dual_mono_mode main -f mpegts -analyzeduration 500000 -i pipe:0 -map 0 -c:s copy -c:d
                      copy -ignore_unknown -fflags nobuffer -flags low_delay -max_delay 250000 -max_interleave_delta 1
                      -threads 0 -c:a aac -ar 48000 -b:a 128k -ac 2 -c:v libx264 -flags +cgop -vf yadif,scale=-2:480
                      -b:v 1500k -preset veryfast -y -f mpegts pipe:1'

            webm:
                - name: 1080p
                  cmd:
                      '%FFMPEG% -re -dual_mono_mode main -i pipe:0 -sn -threads 3 -c:a libvorbis -ar 48000 -b:a 192k -ac
                      2 -c:v vp9_qsv -vf yadif,scale=-2:1080 -b:v 3000k -deadline realtime -speed 4 -cpu-used -8 -y -f
                      webm pipe:1'
                - name: 720p
                  cmd:
                      '%FFMPEG% -re -dual_mono_mode main -i pipe:0 -sn -threads 3 -c:a libvorbis -ar 48000 -b:a 192k -ac
                      2 -c:v vp9_qsv -vf yadif,scale=-2:720 -b:v 3000k -deadline realtime -speed 4 -cpu-used -8 -y -f
                      webm pipe:1'
                - name: 480p
                  cmd:
                      '%FFMPEG% -re -dual_mono_mode main -i pipe:0 -sn -threads 2 -c:a libvorbis -ar 48000 -b:a 128k -ac
                      2 -c:v vp9_qsv -vf yadif,scale=-2:480 -b:v 1500k -deadline realtime -speed 4 -cpu-used -8 -y -f
                      webm pipe:1'

            mp4:
                - name: 1080p
                  cmd:
                      '%FFMPEG% -re -dual_mono_mode main -i pipe:0 -sn -threads 0 -c:a aac -ar 48000 -b:a 192k -ac 2
                      -c:v libx264 -vf yadif,scale=-2:1080 -b:v 3000k -profile:v baseline -preset veryfast -tune
                      fastdecode,zerolatency -movflags frag_keyframe+empty_moov+faststart+default_base_moof -y -f mp4
                      pipe:1'
                - name: 720p
                  cmd:
                      '%FFMPEG% -re -dual_mono_mode main -i pipe:0 -sn -threads 0 -c:a aac -ar 48000 -b:a 192k -ac 2
                      -c:v libx264 -vf yadif,scale=-2:720 -b:v 3000k -profile:v baseline -preset veryfast -tune
                      fastdecode,zerolatency -movflags frag_keyframe+empty_moov+faststart+default_base_moof -y -f mp4
                      pipe:1'
                - name: 480p
                  cmd:
                      '%FFMPEG% -re -dual_mono_mode main -i pipe:0 -sn -threads 0 -c:a aac -ar 48000 -b:a 128k -ac 2
                      -c:v libx264 -vf yadif,scale=-2:480 -b:v 1500k -profile:v baseline -preset veryfast -tune
                      fastdecode,zerolatency -movflags frag_keyframe+empty_moov+faststart+default_base_moof -y -f mp4
                      pipe:1'

            hls:
                # in-memory HLS (低遅延・ディスク書き込みなし)
                # cmd が %streamFileDir% を含まない場合、fragmented MP4 を標準出力 (pipe:1) へ書き出す
                # コマンドとみなされ、セグメントはメモリ上でのみ保持・配信される (Windows でも動作)
                # cmd に | を含めるとシェル経由で実行される (tsreadex などの前処理に利用可)
                # 従来の TS セグメント方式 (ディスク書き込み) に戻す場合は下部のコメント例を参照
                - name: 1080p(低遅延)
                  cmd:
                      '%FFMPEG% -re -dual_mono_mode main -i pipe:0 -sn -threads 0 -max_muxing_queue_size 1024
                      -c:a aac -ar 48000 -b:a 192k -ac 2
                      -c:v libx264 -vf yadif,scale=-2:1080 -b:v 5000k -maxrate 5000k -bufsize 10000k
                      -profile:v high -level 4.1 -preset veryfast -tune fastdecode,zerolatency
                      -g 30 -keyint_min 30 -sc_threshold 0
                      -movflags empty_moov+default_base_moof+frag_keyframe -f mp4 pipe:1'
                - name: 720p(低遅延)
                  cmd:
                      '%FFMPEG% -re -dual_mono_mode main -i pipe:0 -sn -threads 0 -max_muxing_queue_size 1024
                      -c:a aac -ar 48000 -b:a 192k -ac 2
                      -c:v libx264 -vf yadif,scale=-2:720 -b:v 3000k -maxrate 3000k -bufsize 6000k
                      -profile:v high -level 4.0 -preset veryfast -tune fastdecode,zerolatency
                      -g 30 -keyint_min 30 -sc_threshold 0
                      -movflags empty_moov+default_base_moof+frag_keyframe -f mp4 pipe:1'
                - name: 480p(低遅延)
                  cmd:
                      '%FFMPEG% -re -dual_mono_mode main -i pipe:0 -sn -threads 0 -max_muxing_queue_size 1024
                      -c:a aac -ar 48000 -b:a 128k -ac 2
                      -c:v libx264 -vf yadif,scale=-2:480 -b:v 1500k -maxrate 1500k -bufsize 3000k
                      -profile:v main -level 3.1 -preset veryfast -tune fastdecode,zerolatency
                      -g 30 -keyint_min 30 -sc_threshold 0
                      -movflags empty_moov+default_base_moof+frag_keyframe -f mp4 pipe:1'
                # HEVC (H.265) 版: 同画質で H.264 の約半分のビットレート
                # -tag:v hvc1 は Safari / iOS での再生に必須
                # 再生可否: Safari / iOS はネイティブ対応、その他のブラウザは端末の HW デコーダ依存
                # - name: 1080p(HEVC低遅延)
                #   cmd:
                #       '%FFMPEG% -re -dual_mono_mode main -i pipe:0 -sn -threads 0 -max_muxing_queue_size 1024
                #       -c:a aac -ar 48000 -b:a 192k -ac 2
                #       -c:v libx265 -vf yadif,scale=-2:1080 -b:v 2700k -maxrate 2700k -bufsize 5400k
                #       -preset veryfast -tune zerolatency
                #       -g 30 -keyint_min 30 -x265-params scenecut=0:repeat-headers=1
                #       -tag:v hvc1 -movflags empty_moov+default_base_moof+frag_keyframe -f mp4 pipe:1'
                # - name: 720p(HEVC低遅延)
                #   cmd:
                #       '%FFMPEG% -re -dual_mono_mode main -i pipe:0 -sn -threads 0 -max_muxing_queue_size 1024
                #       -c:a aac -ar 48000 -b:a 192k -ac 2
                #       -c:v libx265 -vf yadif,scale=-2:720 -b:v 1600k -maxrate 1600k -bufsize 3200k
                #       -preset veryfast -tune zerolatency
                #       -g 30 -keyint_min 30 -x265-params scenecut=0:repeat-headers=1
                #       -tag:v hvc1 -movflags empty_moov+default_base_moof+frag_keyframe -f mp4 pipe:1'
                # tsreadex で TS を前処理する場合 (デュアルモノ分離・欠落音声の無音埋め・ワンセグ等の除去)
                # tsreadex のパスは config の tsreadex で指定 (省略時は PATH 上の tsreadex)
                # - name: 720p(tsreadex)
                #   cmd:
                #       '%TSREADEX% -x 18 -n -1 -a 13 -b 5 -c 1 -u 1 - | %FFMPEG% -re -f mpegts -analyzeduration 500000 -i pipe:0
                #       -sn -threads 0 -max_muxing_queue_size 1024
                #       -c:a aac -ar 48000 -b:a 192k -ac 2
                #       -c:v libx264 -vf yadif,scale=-2:720 -b:v 3000k -maxrate 3000k -bufsize 6000k
                #       -profile:v high -level 4.0 -preset veryfast -tune fastdecode,zerolatency
                #       -g 30 -keyint_min 30 -sc_threshold 0
                #       -movflags empty_moov+default_base_moof+frag_keyframe -f mp4 pipe:1'
                # 従来の TS セグメント方式 (ディスク書き込みあり・字幕対応)
                # - name: 720p
                #   cmd:
                #       '%FFMPEG% -re -dual_mono_mode main -i pipe:0 -sn -map 0 -threads 0 -ignore_unknown
                #       -max_muxing_queue_size 1024 -f hls -hls_time 3 -hls_list_size 17 -hls_allow_cache 1
                #       -hls_segment_filename %streamFileDir%/stream%streamNum%-%09d.ts -hls_flags delete_segments -c:a
                #       aac -ar 48000 -b:a 192k -ac 2 -c:v libx264 -vf yadif,scale=-2:720 -b:v 3000k -preset veryfast
                #       -flags +loop-global_header %OUTPUT%'
                # - name: 720p (arib)
                #   cmd:
                #       '%FFMPEG% -re -dual_mono_mode main -fix_sub_duration -i pipe:0 -threads 0 -ignore_unknown
                #       -max_muxing_queue_size 1024 -f hls -hls_time 3 -hls_list_size 17 -hls_allow_cache 1
                #       -hls_segment_filename %streamFileDir%/stream%streamNum%-%09d.ts -hls_flags delete_segments -c:a
                #       aac -ar 48000 -b:a 192k -ac 2 -c:v libx264 -vf yadif,scale=-2:720 -b:v 3000k -preset veryfast
                #       -flags +loop-global_header -c:s webvtt -master_pl_name stream%streamNum%.m3u8
                #       %streamFileDir%/stream%streamNum%-child.m3u8'

    recorded:
        # 録画再生用のエンコード設定 (低遅延版)
        # mp4 / hls は再生開始までの待ち時間とシーク応答を短縮するため、以下を設定している
        #   - -fflags nobuffer / -flags low_delay / -analyzeduration 500000: 入力解析の待ちを最小化
        #   - -g 30 -keyint_min 30 -sc_threshold 0: GOP を 1 秒に固定しシーク・セグメント境界を揃える
        #   - -tune fastdecode,zerolatency: エンコーダ内部の先読み (B フレーム等) を無効化
        #   - mp4: faststart を外し fragmented MP4 を即時出力 (-frag_duration 500000)
        #   - hls: -hls_time 1 で 1 秒セグメント化し、初回再生開始を高速化
        ts:
            webm:
                - name: 1080p
                  cmd:
                      '%FFMPEG% -dual_mono_mode main -i pipe:0 -sn -threads 3 -c:a libvorbis -ar 48000
                      -b:a 192k -ac 2 -c:v vp9_qsv -vf yadif,scale=-2:1080 -b:v 3000k -deadline realtime -speed 4
                      -cpu-used -8 -y -f webm pipe:1'
                - name: 720p
                  cmd:
                      '%FFMPEG% -dual_mono_mode main -i pipe:0 -sn -threads 3 -c:a libvorbis -ar 48000
                      -b:a 192k -ac 2 -c:v vp9_qsv -vf yadif,scale=-2:720 -b:v 3000k -deadline realtime -speed 4
                      -cpu-used -8 -y -f webm pipe:1'
                - name: 480p
                  cmd:
                      '%FFMPEG% -dual_mono_mode main -i pipe:0 -sn -threads 3 -c:a libvorbis -ar 48000
                      -b:a 128k -ac 2 -c:v vp9_qsv -vf yadif,scale=-2:480 -b:v 1500k -deadline realtime -speed 4
                      -cpu-used -8 -y -f webm pipe:1'

            mp4:
                - name: 1080p(低遅延)
                  cmd:
                      '%FFMPEG% -dual_mono_mode main -fflags nobuffer -flags low_delay
                      -analyzeduration 500000 -probesize 5000000 -i pipe:0 -sn -threads 0
                      -max_muxing_queue_size 1024 -max_interleave_delta 1
                      -c:a aac -ar 48000 -b:a 192k -ac 2
                      -c:v libx264 -vf yadif,scale=-2:1080 -b:v 3000k -maxrate 3000k -bufsize 6000k
                      -profile:v high -level 4.1 -preset veryfast -tune fastdecode,zerolatency
                      -g 30 -keyint_min 30 -sc_threshold 0
                      -movflags empty_moov+default_base_moof+frag_keyframe -frag_duration 500000
                      -y -f mp4 pipe:1'
                - name: 720p(低遅延)
                  cmd:
                      '%FFMPEG% -dual_mono_mode main -fflags nobuffer -flags low_delay
                      -analyzeduration 500000 -probesize 5000000 -i pipe:0 -sn -threads 0
                      -max_muxing_queue_size 1024 -max_interleave_delta 1
                      -c:a aac -ar 48000 -b:a 192k -ac 2
                      -c:v libx264 -vf yadif,scale=-2:720 -b:v 3000k -maxrate 3000k -bufsize 6000k
                      -profile:v high -level 4.0 -preset veryfast -tune fastdecode,zerolatency
                      -g 30 -keyint_min 30 -sc_threshold 0
                      -movflags empty_moov+default_base_moof+frag_keyframe -frag_duration 500000
                      -y -f mp4 pipe:1'
                - name: 480p(低遅延)
                  cmd:
                      '%FFMPEG% -dual_mono_mode main -fflags nobuffer -flags low_delay
                      -analyzeduration 500000 -probesize 5000000 -i pipe:0 -sn -threads 0
                      -max_muxing_queue_size 1024 -max_interleave_delta 1
                      -c:a aac -ar 48000 -b:a 128k -ac 2
                      -c:v libx264 -vf yadif,scale=-2:480 -b:v 1500k -maxrate 1500k -bufsize 3000k
                      -profile:v main -level 3.1 -preset veryfast -tune fastdecode,zerolatency
                      -g 30 -keyint_min 30 -sc_threshold 0
                      -movflags empty_moov+default_base_moof+frag_keyframe -frag_duration 500000
                      -y -f mp4 pipe:1'

            hls:
                - name: 1080p(低遅延)
                  cmd:
                      '%FFMPEG% -dual_mono_mode main -i pipe:0 -sn -map 0 -threads 0 -ignore_unknown
                      -max_muxing_queue_size 1024 -max_interleave_delta 1
                      -f hls -hls_time 1 -hls_list_size 0 -hls_allow_cache 1
                      -hls_segment_filename %streamFileDir%/stream%streamNum%-%09d.ts
                      -hls_flags delete_segments+independent_segments
                      -c:a aac -ar 48000 -b:a 192k -ac 2
                      -c:v libx264 -vf yadif,scale=-2:1080 -b:v 3000k -maxrate 3000k -bufsize 6000k
                      -preset veryfast -tune fastdecode,zerolatency
                      -g 30 -keyint_min 30 -sc_threshold 0
                      -flags +loop-global_header %OUTPUT%'
                - name: 720p(低遅延)
                  cmd:
                      '%FFMPEG% -dual_mono_mode main -i pipe:0 -sn -map 0 -threads 0 -ignore_unknown
                      -max_muxing_queue_size 1024 -max_interleave_delta 1
                      -f hls -hls_time 1 -hls_list_size 0 -hls_allow_cache 1
                      -hls_segment_filename %streamFileDir%/stream%streamNum%-%09d.ts
                      -hls_flags delete_segments+independent_segments
                      -c:a aac -ar 48000 -b:a 192k -ac 2
                      -c:v libx264 -vf yadif,scale=-2:720 -b:v 3000k -maxrate 3000k -bufsize 6000k
                      -preset veryfast -tune fastdecode,zerolatency
                      -g 30 -keyint_min 30 -sc_threshold 0
                      -flags +loop-global_header %OUTPUT%'
                - name: 480p(低遅延)
                  cmd:
                      '%FFMPEG% -dual_mono_mode main -i pipe:0 -sn -map 0 -threads 0 -ignore_unknown
                      -max_muxing_queue_size 1024 -max_interleave_delta 1
                      -f hls -hls_time 1 -hls_list_size 0 -hls_allow_cache 1
                      -hls_segment_filename %streamFileDir%/stream%streamNum%-%09d.ts
                      -hls_flags delete_segments+independent_segments
                      -c:a aac -ar 48000 -b:a 128k -ac 2
                      -c:v libx264 -vf yadif,scale=-2:480 -b:v 1500k -maxrate 1500k -bufsize 3000k
                      -preset veryfast -tune fastdecode,zerolatency
                      -g 30 -keyint_min 30 -sc_threshold 0
                      -flags +loop-global_header %OUTPUT%'
                # 字幕付き (arib) の従来設定を使う場合は以下を参照
                # - name: 720p (arib)
                #   cmd:
                #       '%FFMPEG% -dual_mono_mode main -fix_sub_duration -i pipe:0 -threads 0 -ignore_unknown
                #       -max_muxing_queue_size 1024 -f hls -hls_time 3 -hls_list_size 0 -hls_allow_cache 1
                #       -hls_segment_filename %streamFileDir%/stream%streamNum%-%09d.ts -hls_flags delete_segments -c:a
                #       aac -ar 48000 -b:a 192k -ac 2 -c:v libx264 -vf yadif,scale=-2:720 -b:v 3000k -preset veryfast
                #       -flags +loop-global_header -c:s webvtt -master_pl_name stream%streamNum%.m3u8
                #       %streamFileDir%/stream%streamNum%-child.m3u8'

        encoded:
            webm:
                - name: 1080p
                  cmd:
                      '%FFMPEG% -dual_mono_mode main -ss %SS% -i %INPUT% -sn -threads 3 -c:a libvorbis -ar 48000
                      -b:a 192k -ac 2 -c:v vp9_qsv -vf scale=-2:1080 -b:v 3000k -deadline realtime -speed 4
                      -cpu-used -8 -y -f webm pipe:1'
                - name: 720p
                  cmd:
                      '%FFMPEG% -dual_mono_mode main -ss %SS% -i %INPUT% -sn -threads 3 -c:a libvorbis -ar 48000
                      -b:a 192k -ac 2 -c:v vp9_qsv -vf scale=-2:720 -b:v 3000k -deadline realtime -speed 4
                      -cpu-used -8 -y -f webm pipe:1'
                - name: 480p
                  cmd:
                      '%FFMPEG% -dual_mono_mode main -ss %SS% -i %INPUT% -sn -threads 3 -c:a libvorbis -ar 48000
                      -b:a 128k -ac 2 -c:v vp9_qsv -vf scale=-2:480 -b:v 1500k -deadline realtime -speed 4
                      -cpu-used -8 -y -f webm pipe:1'

            mp4:
                - name: 1080p(低遅延)
                  cmd:
                      '%FFMPEG% -dual_mono_mode main -fflags nobuffer -flags low_delay
                      -analyzeduration 500000 -probesize 5000000 -ss %SS% -i %INPUT% -sn -threads 0
                      -max_muxing_queue_size 1024 -max_interleave_delta 1
                      -c:a aac -ar 48000 -b:a 192k -ac 2
                      -c:v libx264 -vf scale=-2:1080 -b:v 3000k -maxrate 3000k -bufsize 6000k
                      -profile:v high -level 4.1 -preset veryfast -tune fastdecode,zerolatency
                      -g 30 -keyint_min 30 -sc_threshold 0
                      -movflags empty_moov+default_base_moof+frag_keyframe -frag_duration 500000
                      -y -f mp4 pipe:1'
                - name: 720p(低遅延)
                  cmd:
                      '%FFMPEG% -dual_mono_mode main -fflags nobuffer -flags low_delay
                      -analyzeduration 500000 -probesize 5000000 -ss %SS% -i %INPUT% -sn -threads 0
                      -max_muxing_queue_size 1024 -max_interleave_delta 1
                      -c:a aac -ar 48000 -b:a 192k -ac 2
                      -c:v libx264 -vf scale=-2:720 -b:v 3000k -maxrate 3000k -bufsize 6000k
                      -profile:v high -level 4.0 -preset veryfast -tune fastdecode,zerolatency
                      -g 30 -keyint_min 30 -sc_threshold 0
                      -movflags empty_moov+default_base_moof+frag_keyframe -frag_duration 500000
                      -y -f mp4 pipe:1'
                - name: 480p(低遅延)
                  cmd:
                      '%FFMPEG% -dual_mono_mode main -fflags nobuffer -flags low_delay
                      -analyzeduration 500000 -probesize 5000000 -ss %SS% -i %INPUT% -sn -threads 0
                      -max_muxing_queue_size 1024 -max_interleave_delta 1
                      -c:a aac -ar 48000 -b:a 128k -ac 2
                      -c:v libx264 -vf scale=-2:480 -b:v 1500k -maxrate 1500k -bufsize 3000k
                      -profile:v main -level 3.1 -preset veryfast -tune fastdecode,zerolatency
                      -g 30 -keyint_min 30 -sc_threshold 0
                      -movflags empty_moov+default_base_moof+frag_keyframe -frag_duration 500000
                      -y -f mp4 pipe:1'

            hls:
                - name: 1080p(低遅延)
                  cmd:
                      '%FFMPEG% -dual_mono_mode main -ss %SS% -i %INPUT% -sn -threads 0 -ignore_unknown
                      -max_muxing_queue_size 1024 -max_interleave_delta 1
                      -f hls -hls_time 1 -hls_list_size 0 -hls_allow_cache 1
                      -hls_segment_filename %streamFileDir%/stream%streamNum%-%09d.ts
                      -hls_flags delete_segments+independent_segments
                      -c:a aac -ar 48000 -b:a 192k -ac 2
                      -c:v libx264 -vf scale=-2:1080 -b:v 3000k -maxrate 3000k -bufsize 6000k
                      -preset veryfast -tune fastdecode,zerolatency
                      -g 30 -keyint_min 30 -sc_threshold 0
                      -flags +loop-global_header %OUTPUT%'
                - name: 720p(低遅延)
                  cmd:
                      '%FFMPEG% -dual_mono_mode main -ss %SS% -i %INPUT% -sn -threads 0 -ignore_unknown
                      -max_muxing_queue_size 1024 -max_interleave_delta 1
                      -f hls -hls_time 1 -hls_list_size 0 -hls_allow_cache 1
                      -hls_segment_filename %streamFileDir%/stream%streamNum%-%09d.ts
                      -hls_flags delete_segments+independent_segments
                      -c:a aac -ar 48000 -b:a 192k -ac 2
                      -c:v libx264 -vf scale=-2:720 -b:v 3000k -maxrate 3000k -bufsize 6000k
                      -preset veryfast -tune fastdecode,zerolatency
                      -g 30 -keyint_min 30 -sc_threshold 0
                      -flags +loop-global_header %OUTPUT%'
                - name: 480p(低遅延)
                  cmd:
                      '%FFMPEG% -dual_mono_mode main -ss %SS% -i %INPUT% -sn -threads 0 -ignore_unknown
                      -max_muxing_queue_size 1024 -max_interleave_delta 1
                      -f hls -hls_time 1 -hls_list_size 0 -hls_allow_cache 1
                      -hls_segment_filename %streamFileDir%/stream%streamNum%-%09d.ts
                      -hls_flags delete_segments+independent_segments
                      -c:a aac -ar 48000 -b:a 128k -ac 2
                      -c:v libx264 -vf scale=-2:480 -b:v 1500k -maxrate 1500k -bufsize 3000k
                      -preset veryfast -tune fastdecode,zerolatency
                      -g 30 -keyint_min 30 -sc_threshold 0
                      -flags +loop-global_header %OUTPUT%'

# stream.profiles: id ベースの配信プリセット設定 (新形式)。
# 上記の stream.live / stream.recorded (旧形式) と併存でき、同じスコープ (live / recorded.ts / recorded.encoded) に
# 新形式が定義されている場合はそちらが優先される (旧形式は無視される)。
# cmd を省略した場合 container / video / audio から ffmpeg コマンドを自動生成する。
# video / audio も省略した場合は無変換 (isUnconverted) 配信になる。
# stream:
#     profiles:
#         live:
#             - id: live-hls-1080p
#               name: 1080p (HLS)
#               container: hls
#               video:
#                   codec: libx264
#                   height: 1080
#                   bitrate: 3000
#               audio:
#                   codec: aac
#                   bitrate: 192
#             - id: live-hls-unconverted
#               name: 無変換 (HLS)
#               container: hls
#         recorded:
#             ts:
#                 - id: recorded-ts-mp4-720p
#                   name: 720p
#                   container: mp4
#                   video:
#                       height: 720
#                       bitrate: 3000
#             encoded:
#                 - id: recorded-encoded-mp4-720p
#                   name: 720p
#                   container: mp4
#                   video:
#                       height: 720
#                       bitrate: 3000

# 秘密情報暗号化鍵。運用環境では十分長いランダム値へ変更してください。
# secretKey: change-this-to-a-long-random-secret

# 段階導入用機能フラグ。明示的に true にした機能だけが有効になります。
# 未指定の項目は false として扱われます。
featureFlags:
    watchHistory: false
    notifications: false
    dashboard: false
    systemSettings: false
    seriesLibrary: false
    metadataProviders: false
    programSeriesMapping: false
    annictSync: false
    nextUpPanel: false
    externalFileImport: false
    advancedSearch: false

# しょぼいカレンダー ChID ⇄ Mirakurun networkId/serviceId のマッピング表 (JSON) のパス。
# 省略時は同梱の初期データ (主要地上波キー局のみ) を使う。指定したファイルの内容は同梱データを
# 上書き/追加する (featureFlags.metadataProviders: true の場合のみ使用される)
# metadataChannelMappingPath: 'C:\path\to\syobocal-channel-map.json'

# チャンネルマッピング表・エイリアス辞書等の共有静的データを GitHub 等から自動取得する URL (§5.1)。
# 起動時 + metadataSharedDataUpdateIntervalMs 間隔で取得し、ローカル (data\metadataSharedData.json) に
# キャッシュする。オフライン/取得失敗時は前回キャッシュ→同梱データの順にフォールバックする
# (featureFlags.metadataProviders: true の場合のみ使用される)
# metadataSharedDataUrl: 'https://raw.githubusercontent.com/<user>/<repo>/main/syobocal-shared-data.json'
# 自動更新間隔 (ms)。省略時 24 時間。0 を指定すると起動時取得のみで定期更新を行わない
# metadataSharedDataUpdateIntervalMs: 86400000

# Webhook / Discord 通知（featureFlags.notifications: true の場合のみ有効）
# notifications:
#     maxAttempts: 5
#     baseDelayMs: 1000
#     timeoutMs: 10000
#     targets:
#         - name: discord
#           type: discord
#           url: https://discord.com/api/webhooks/...
#           events: [recording.started, recording.completed, recording.failed]
#         - name: automation
#           type: webhook
#           url: https://example.invalid/epgstation
#           secret: change-me
