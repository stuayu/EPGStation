port: 8888
# mirakurunPath は named pipe, http, https の URL が指定可能
# https 例: mirakurunPath: https://mirakurun.example.com
mirakurunPath: http://localhost:40772
# mirakurun の API エンドポイントのベースパス (省略時 /api)
# mirakurunAPIPath: /api

# dbtype: sqlite
# sqlite:
#   extensions:
#     - '/hoge/regexp.dylib'
#   regexp: true

dbtype: mysql
mysql:
    host: localhost
    port: 3306
    user: epgstation
    password: epgstation
    database: epgstation
    charset: utf8mb4

# 囲み文字を置換するか
needToReplaceEnclosingCharacters: true

apiServers:
    - http://localhost:8888
    - http://192.168.2.110:8888

epgUpdateIntervalTime: 10

# 過去の番組表データを残す時間 (時間)
# 0: 終了した番組を順次削除する (既定) / -1: 削除せず無期限に残す
epgRetentionTime: 0

# 過去の番組表データを削除する間隔 (分)。省略時は epgUpdateIntervalTime と同じ
#epgDeleteIntervalTime: 60

conflictPriority: 1
recPriority: 2
isEnabledDropCheck: true

recordedFormat: '%YEAR%年%MONTH%月%DAY%日%HOUR%時%MIN%分%SEC%秒-%HALF_WIDTH_TITLE%_%HALF_WIDTH_CHNAME%'
recordedFileExtension: .m2ts
recorded:
    - name: recorded
      path: '%ROOT%/recorded'

# 外部録画ファイル (EDCB 等) の取り込みを許可するディレクトリ (featureFlags.externalFileImport: true の場合のみ有効)
# 未設定 (コメントアウトのまま) だと取り込み機能自体が無効になる
# importDirs:
#     - name: edcb
#       path: 'D:\EDCB\Recorded'
# importDefaultMode: register # register: 元ファイルを移動せず登録のみ行う / move: 録画ディレクトリへ移動する
# importFileNamePatterns: [] # EDCB ファイル名推定用のカスタム正規表現 (named capture group: year,month,day,hour,min,sec,name,channel)
# importWatch: false # true にすると importDirs を定期的に監視し新規ファイルを自動取り込みする
# importWatchIntervalSec: 300

thumbnail: '%ROOT%/thumbnail'
thumbnailSize: 480x270
thumbnailPosition: 5

ffmpeg: 'C:\rec\ffmpeg\bin\ffmpeg.exe'
ffprobe: 'C:\rec\ffmpeg\bin\ffprobe.exe'

# tsreadex の実行ファイルパス (ライブ HLS の cmd で %TSREADEX% を使う場合に指定、省略時は PATH 上の tsreadex)
# tsreadex: /usr/local/bin/tsreadex

# rigaya 氏製ハードウェアエンコーダの実行ファイルパス (省略時は PATH 上の QSVEncC / NVEncC / VCEEncC)
# encodePresets の hwaccel に qsvencc / nvencc / vceencc を指定した場合に使われる。
# config/enc.js には環境変数 QSVENCC / NVENCC / VCEENCC として渡される
# qsvencc: 'C:\rec\QSVEncC\QSVEncC64.exe'
# nvencc: 'C:\rec\NVEncC\NVEncC64.exe'
# vceencc: 'C:\rec\VCEEncC\VCEEncC64.exe'

# 録画ファイルのバックグラウンドエンコード上限
encodeProcessNum: 4
# ライブ視聴・録画再生ストリーミングの上限（encodeProcessNum とは別枠）
streamProcessNum: 4
concurrentEncodeNum: 1

# =====================================================================================
# エンコードプリセット表 (encodePresets) — ハードウェア × コーデック × 画質を一括有効化する
# =====================================================================================
# 録画エンコード (encode) とライブ HLS・録画ストリーミング (stream.profiles) を、
# 「ハードウェア (software / qsv (Intel) / vaapi (AMD) / nvenc (NVIDIA) /
#   qsvencc / nvencc / vceencc (rigaya 氏製エンコーダ)) ×
#   コーデック (h264 / hevc) × 画質 (1080p / 720p / 480p / 240p) × 用途」の
# 組み合わせから自動生成する。1 つずつ手書きしてコメントアウトで管理する代わりに、
# 使いたい軸をフラグで指定するだけで該当する組み合わせがまとめて有効になる。
#
# - hwaccel: 使用するハードウェアアクセラレーション (省略時 software)。
#     software | qsv | vaapi | nvenc | qsvencc | nvencc | vceencc
#     software / qsv / vaapi / nvenc は ffmpeg のエンコーダを使う。ffmpeg が対応エンコーダ
#     (libx264/libx265, h264_qsv/hevc_qsv, h264_vaapi/hevc_vaapi, h264_nvenc/hevc_nvenc) 付きで
#     ビルドされていること。vaapi (AMD) は Linux 専用 (Windows では利用不可)
#     qsvencc / nvencc / vceencc は rigaya 氏製の QSVEncC / NVEncC / VCEEncC を使う
#     (実行ファイルパスは上記の qsvencc / nvencc / vceencc で指定。AMD GPU の Windows 環境では
#      vceencc が選択肢になる。配信では rigaya 側でデコード〜エンコードまで行い ffmpeg へパイプする)
# - codecs: 有効化するコーデック配列 (省略時 [h264])。hevc は同画質で H.264 の約半分のビットレート
# - qualities: 有効化する画質配列 (省略時 [1080p, 720p, 480p])
# - targets: 生成対象 (省略時 [recorded, liveHLS, recordedStreaming])
#     recorded: 録画ファイルのバックグラウンドエンコード (config/enc.js 経由)
#     liveHLS: ライブ視聴の HLS 配信 (in-memory 低遅延)
#     recordedStreaming: 録画再生の mp4 / HLS 配信
#     (webm は vp9 系のためこのプリセット表の対象外。従来通り stream.profiles に手書きする)
#
# 優先順位 (手書き優先): 下記の `encode:` / `stream:` セクションに 1 件でも手書きの設定が
# あれば、そのセクション単位で encodePresets からの自動生成は行われない
# (encode 配列全体、stream.profiles.live、stream.profiles.recorded.ts、
#  stream.profiles.recorded.encoded がそれぞれ独立した単位)。
#
# 例: NVIDIA NVENC で H.264/HEVC の 1080p/720p を全用途に対して有効化する場合
# encodePresets:
#     hwaccel: nvenc
#     codecs: [h264, hevc]
#     qualities: [1080p, 720p]
#     targets: [recorded, liveHLS, recordedStreaming]

# 録画ファイルのエンコードプリセット (新形式: id ベース)。
# encodePresets の targets に recorded を含め、かつこの encode 配列が空の場合は自動生成に委ねられる。
# 手書きする場合の書式:
# - id はプリセットの識別子。運用中に name を変更しても id が同じならクライアントの
#   保存済み設定は無効にならない (録画予約・ルールは name で照合されるため name の変更は注意)。
# - video / audio はクライアント表示用の参考情報 (実際のエンコード処理は cmd が担う)。
# - enc.js は引数でエンコーダを切り替えられる:
#     cmd: '%NODE% %ROOT%/config/enc.js [プリセット] [最大高さ]'
#     プリセット: h264 (既定) | hevc | h264_nvenc | hevc_nvenc | h264_qsv | hevc_qsv
#                 | qsvencc_h264 | qsvencc_hevc | nvencc_h264 | nvencc_hevc | vceencc_h264 | vceencc_hevc
#                 (qsvencc_* / nvencc_* / vceencc_* は rigaya 氏製エンコーダを ffmpeg を介さず直接使う)
#     最大高さ:   出力の最大高さ (省略時 720。0 で元解像度のまま)
encode:
    - id: h264-720p
      name: H.264
      cmd: '%NODE% %ROOT%/config/enc.js h264 720'
      suffix: .mp4
      # タイムアウト倍率 (番組長 × この値でエンコードを打ち切る)。
      # enc.js の h264 プリセットは画質優先の -preset slow なので実時間の数倍かかる前提にする
      rate: 10.0
      video:
          codec: libx264
          height: 720
      audio:
          codec: aac
    # =====================================================================
    # 1080p / HEVC / NVENC / QSV の組み合わせを追加したい場合は、
    # 上の encode 配列を空にして (この h264-720p も削除して) ファイル先頭の
    # encodePresets を有効化するのが手軽 (例: hwaccel: nvenc, codecs: [h264, hevc],
    # qualities: [1080p, 720p])。個別に手書きしたい場合のみ、この配列に id ベースで
    # 追記する (書式は上のコメントと config/enc.js の PRESETS 定義を参照)。
    # =====================================================================

urlscheme:
    m2ts:
        ios: vlc-x-callback://x-callback-url/stream?url=PROTOCOL%3A%2F%2FADDRESS
        android: intent://ADDRESS#Intent;action=android.intent.action.VIEW;type=video/*;scheme=PROTOCOL;end
    video:
        ios: infuse://x-callback-url/play?url=PROTOCOL://ADDRESS
        android: intent://ADDRESS#Intent;action=android.intent.action.VIEW;type=video/*;scheme=PROTOCOL;end
    download:
        ios: vlc-x-callback://x-callback-url/download?url=PROTOCOL%3A%2F%2FADDRESS&filename=FILENAME

# 視聴用ストリーミング設定 (新形式: stream.profiles / id ベース)。旧形式 (stream.live / stream.recorded) から全面移行済み。
# - cmd を省略した場合 container / video / audio から ffmpeg コマンドが自動生成される
#   (ソフトウェアエンコーダ前提。既定: m2ts/m2tsll/mp4/hls = libx264 + aac, webm = libvpx-vp9 + libvorbis)。
# - video / audio も省略した場合は無変換 (isUnconverted) 配信になる。
# - NVENC / QSV などハードウェアエンコーダは -preset / -tune 等のオプション体系が異なり
#   自動生成コマンドでは動かないため、必ず cmd を明示すること (下部のコメント例を参照)。
# - id は運用中に変更しないこと (クライアントに保存された設定が無効になる)。
# - 旧形式の ?mode=N は「同じ container 内の並び順」で解決されるため、各 container 内の
#   解像度の並び (1080p → 720p → 480p → ...) は変更しないこと。
stream:
    profiles:
        live:
            # ================= HLS (in-memory 低遅延・ディスク書き込みなし) =================
            # cmd が %streamFileDir% を含まない場合、fragmented MP4 を標準出力 (pipe:1) へ書き出す
            # コマンドとみなされ、セグメントはメモリ上でのみ保持・配信される (Windows でも動作)
            # cmd に | を含めるとシェル経由で実行される (tsreadex などの前処理に利用可)
            # 従来の TS セグメント方式 (ディスク書き込み) に戻す場合は下部のコメント例を参照
            - id: live-hls-1080p-avc
              name: 1080p(低遅延)
              container: hls
              video:
                  codec: libx264
                  height: 1080
                  bitrate: 5000
              audio:
                  codec: aac
                  bitrate: 192
              cmd:
                  '%FFMPEG% -dual_mono_mode main -fflags nobuffer -i pipe:0 -sn -threads 0 -max_muxing_queue_size 1024
                  -c:a aac -ar 48000 -b:a 192k -ac 2
                  -c:v libx264 -vf yadif,scale=-2:1080 -b:v 5000k -maxrate 5000k -bufsize 10000k
                  -profile:v high -level 4.1 -preset veryfast -tune fastdecode,zerolatency
                  -g 15 -keyint_min 15 -sc_threshold 0
                  -movflags empty_moov+default_base_moof+frag_keyframe -f mp4 pipe:1'
            - id: live-hls-720p-avc
              name: 720p(低遅延)
              container: hls
              video:
                  codec: libx264
                  height: 720
                  bitrate: 3000
              audio:
                  codec: aac
                  bitrate: 192
              cmd:
                  '%FFMPEG% -dual_mono_mode main -fflags nobuffer -i pipe:0 -sn -threads 0 -max_muxing_queue_size 1024
                  -c:a aac -ar 48000 -b:a 192k -ac 2
                  -c:v libx264 -vf yadif,scale=-2:720 -b:v 3000k -maxrate 3000k -bufsize 6000k
                  -profile:v high -level 4.0 -preset veryfast -tune fastdecode,zerolatency
                  -g 15 -keyint_min 15 -sc_threshold 0
                  -movflags empty_moov+default_base_moof+frag_keyframe -f mp4 pipe:1'
            - id: live-hls-480p-avc
              name: 480p(低遅延)
              container: hls
              video:
                  codec: libx264
                  height: 480
                  bitrate: 1500
              audio:
                  codec: aac
                  bitrate: 128
              cmd:
                  '%FFMPEG% -dual_mono_mode main -fflags nobuffer -i pipe:0 -sn -threads 0 -max_muxing_queue_size 1024
                  -c:a aac -ar 48000 -b:a 128k -ac 2
                  -c:v libx264 -vf yadif,scale=-2:480 -b:v 1500k -maxrate 1500k -bufsize 3000k
                  -profile:v main -level 3.1 -preset veryfast -tune fastdecode,zerolatency
                  -g 15 -keyint_min 15 -sc_threshold 0
                  -movflags empty_moov+default_base_moof+frag_keyframe -f mp4 pipe:1'

            # ------------- HLS 追加プリセット (HEVC / NVENC / QSV / VAAPI) -------------
            # これらの組み合わせはファイル先頭の encodePresets (hwaccel: nvenc / qsv / vaapi,
            # codecs: [h264, hevc]) で自動生成できる (vaapi は Linux 専用)。個別に手書きしたい場合や
            # GPU デコード (-hwaccel cuda 等) まで含めて細かく調整したい場合のみ、
            # 生成された cmd を出発点にこの配列へ書き足すこと。
            # ----- tsreadex で TS を前処理する場合 (デュアルモノ分離・欠落音声の無音埋め・ワンセグ等の除去) -----
            # tsreadex のパスは config の tsreadex で指定 (省略時は PATH 上の tsreadex)
            # - id: live-hls-720p-tsreadex
            #   name: 720p(tsreadex)
            #   container: hls
            #   cmd:
            #       '%TSREADEX% -x 18 -n -1 -a 13 -b 5 -c 1 -u 1 - | %FFMPEG% -re -f mpegts -analyzeduration 500000 -i pipe:0
            #       -sn -threads 0 -max_muxing_queue_size 1024
            #       -c:a aac -ar 48000 -b:a 192k -ac 2
            #       -c:v libx264 -vf yadif,scale=-2:720 -b:v 3000k -maxrate 3000k -bufsize 6000k
            #       -profile:v high -level 4.0 -preset veryfast -tune fastdecode,zerolatency
            #       -g 30 -keyint_min 30 -sc_threshold 0
            #       -movflags empty_moov+default_base_moof+frag_keyframe -f mp4 pipe:1'
            #
            # ----- 従来の TS セグメント方式 (ディスク書き込みあり・字幕対応) -----
            # - id: live-hls-720p-tssegment
            #   name: 720p(TSセグメント)
            #   container: hls
            #   cmd:
            #       '%FFMPEG% -re -dual_mono_mode main -i pipe:0 -sn -map 0 -threads 0 -ignore_unknown
            #       -max_muxing_queue_size 1024 -f hls -hls_time 3 -hls_list_size 17 -hls_allow_cache 1
            #       -hls_segment_filename %streamFileDir%/stream%streamNum%-%09d.ts -hls_flags delete_segments -c:a
            #       aac -ar 48000 -b:a 192k -ac 2 -c:v libx264 -vf yadif,scale=-2:720 -b:v 3000k -preset veryfast
            #       -flags +loop-global_header %OUTPUT%'
            # - id: live-hls-720p-arib
            #   name: 720p(arib)
            #   container: hls
            #   cmd:
            #       '%FFMPEG% -re -dual_mono_mode main -fix_sub_duration -i pipe:0 -threads 0 -ignore_unknown
            #       -max_muxing_queue_size 1024 -f hls -hls_time 3 -hls_list_size 17 -hls_allow_cache 1
            #       -hls_segment_filename %streamFileDir%/stream%streamNum%-%09d.ts -hls_flags delete_segments -c:a
            #       aac -ar 48000 -b:a 192k -ac 2 -c:v libx264 -vf yadif,scale=-2:720 -b:v 3000k -preset veryfast
            #       -flags +loop-global_header -c:s webvtt -master_pl_name stream%streamNum%.m3u8
            #       %streamFileDir%/stream%streamNum%-child.m3u8'

            # ================= M2TS (MPEG-TS / 外部プレイヤー向け) =================
            # cmd 省略時は container / video / audio から自動生成される
            - id: live-m2ts-1080p-avc
              name: 1080p
              container: m2ts
              video:
                  codec: libx264
                  height: 1080
                  bitrate: 3000
              audio:
                  codec: aac
                  bitrate: 192
            - id: live-m2ts-720p-avc
              name: 720p
              container: m2ts
              video:
                  codec: libx264
                  height: 720
                  bitrate: 3000
              audio:
                  codec: aac
                  bitrate: 192
            - id: live-m2ts-480p-avc
              name: 480p
              container: m2ts
              video:
                  codec: libx264
                  height: 480
                  bitrate: 1500
              audio:
                  codec: aac
                  bitrate: 128
            - id: live-m2ts-unconverted
              name: 無変換
              container: m2ts

            # ================= M2TS 低遅延 (m2tsll) =================
            - id: live-m2tsll-1080p-avc
              name: 1080p
              container: m2tsll
              video:
                  codec: libx264
                  height: 1080
                  bitrate: 3000
              audio:
                  codec: aac
                  bitrate: 192
            - id: live-m2tsll-720p-avc
              name: 720p
              container: m2tsll
              video:
                  codec: libx264
                  height: 720
                  bitrate: 3000
              audio:
                  codec: aac
                  bitrate: 192
            - id: live-m2tsll-480p-avc
              name: 480p
              container: m2tsll
              video:
                  codec: libx264
                  height: 480
                  bitrate: 1500
              audio:
                  codec: aac
                  bitrate: 128

            # ================= MP4 =================
            - id: live-mp4-1080p-avc
              name: 1080p
              container: mp4
              video:
                  codec: libx264
                  height: 1080
                  bitrate: 3000
              audio:
                  codec: aac
                  bitrate: 192
            - id: live-mp4-720p-avc
              name: 720p
              container: mp4
              video:
                  codec: libx264
                  height: 720
                  bitrate: 3000
              audio:
                  codec: aac
                  bitrate: 192
            - id: live-mp4-480p-avc
              name: 480p
              container: mp4
              video:
                  codec: libx264
                  height: 480
                  bitrate: 1500
              audio:
                  codec: aac
                  bitrate: 128

            # ================= WebM =================
            - id: live-webm-1080p
              name: 1080p
              container: webm
              video:
                  codec: libvpx-vp9
                  height: 1080
                  bitrate: 3000
              audio:
                  codec: libvorbis
                  bitrate: 192
            - id: live-webm-720p
              name: 720p
              container: webm
              video:
                  codec: libvpx-vp9
                  height: 720
                  bitrate: 3000
              audio:
                  codec: libvorbis
                  bitrate: 192
            - id: live-webm-480p
              name: 480p
              container: webm
              video:
                  codec: libvpx-vp9
                  height: 480
                  bitrate: 1500
              audio:
                  codec: libvorbis
                  bitrate: 128

        recorded:
            # 録画再生用。mp4 / hls は再生開始までの待ち時間とシーク応答を短縮する低遅延設定を採用:
            #   - -fflags nobuffer / -flags low_delay / -analyzeduration 500000: 入力解析の待ちを最小化
            #   - -g 30 -keyint_min 30 -sc_threshold 0: GOP を約 1 秒に固定しシーク・セグメント境界を揃える
            #   - -tune fastdecode,zerolatency: エンコーダ内部の先読み (B フレーム等) を無効化
            #   - mp4: fragmented MP4 を即時出力 (-frag_duration 500000)
            #   - hls: -hls_time 1 で 1 秒セグメント化し、初回再生開始を高速化
            ts:
                # ================= MP4 (低遅延) =================
                - id: recorded-ts-mp4-1080p-avc
                  name: 1080p(低遅延)
                  container: mp4
                  video:
                      codec: libx264
                      height: 1080
                      bitrate: 3000
                  audio:
                      codec: aac
                      bitrate: 192
                  cmd:
                      '%FFMPEG% -dual_mono_mode main -fflags nobuffer -flags low_delay
                      -analyzeduration 500000 -probesize 5000000 -i pipe:0 -sn -threads 0
                      -max_muxing_queue_size 1024 -max_interleave_delta 1
                      -c:a aac -ar 48000 -b:a 192k -ac 2
                      -c:v libx264 -vf yadif,scale=-2:1080 -b:v 3000k -maxrate 3000k -bufsize 6000k
                      -profile:v high -level 4.1 -preset veryfast -tune fastdecode,zerolatency
                      -g 30 -keyint_min 30 -sc_threshold 0
                      -movflags empty_moov+default_base_moof+frag_keyframe -frag_duration 500000
                      -y -f mp4 pipe:1'
                - id: recorded-ts-mp4-720p-avc
                  name: 720p(低遅延)
                  container: mp4
                  video:
                      codec: libx264
                      height: 720
                      bitrate: 3000
                  audio:
                      codec: aac
                      bitrate: 192
                  cmd:
                      '%FFMPEG% -dual_mono_mode main -fflags nobuffer -flags low_delay
                      -analyzeduration 500000 -probesize 5000000 -i pipe:0 -sn -threads 0
                      -max_muxing_queue_size 1024 -max_interleave_delta 1
                      -c:a aac -ar 48000 -b:a 192k -ac 2
                      -c:v libx264 -vf yadif,scale=-2:720 -b:v 3000k -maxrate 3000k -bufsize 6000k
                      -profile:v high -level 4.0 -preset veryfast -tune fastdecode,zerolatency
                      -g 30 -keyint_min 30 -sc_threshold 0
                      -movflags empty_moov+default_base_moof+frag_keyframe -frag_duration 500000
                      -y -f mp4 pipe:1'
                - id: recorded-ts-mp4-480p-avc
                  name: 480p(低遅延)
                  container: mp4
                  video:
                      codec: libx264
                      height: 480
                      bitrate: 1500
                  audio:
                      codec: aac
                      bitrate: 128
                  cmd:
                      '%FFMPEG% -dual_mono_mode main -fflags nobuffer -flags low_delay
                      -analyzeduration 500000 -probesize 5000000 -i pipe:0 -sn -threads 0
                      -max_muxing_queue_size 1024 -max_interleave_delta 1
                      -c:a aac -ar 48000 -b:a 128k -ac 2
                      -c:v libx264 -vf yadif,scale=-2:480 -b:v 1500k -maxrate 1500k -bufsize 3000k
                      -profile:v main -level 3.1 -preset veryfast -tune fastdecode,zerolatency
                      -g 30 -keyint_min 30 -sc_threshold 0
                      -movflags empty_moov+default_base_moof+frag_keyframe -frag_duration 500000
                      -y -f mp4 pipe:1'
