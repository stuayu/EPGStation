const spawn = require('child_process').spawn;
const execFile = require('child_process').execFile;
const ffmpeg = process.env.FFMPEG;
const ffprobe = process.env.FFPROBE;

const input = process.env.INPUT;
const output = process.env.OUTPUT;
const analyzedurationSize = '10M'; // Mirakurun の設定に応じて変更すること
const probesizeSize = '32M'; // Mirakurun の設定に応じて変更すること
const dualMonoMode = 'main';
const videoHeight = parseInt(process.env.VIDEORESOLUTION, 10);
const isDualMono = parseInt(process.env.AUDIOCOMPONENTTYPE, 10) == 2;
const audioBitrate = videoHeight > 720 ? '192k' : '128k';

/**
 * エンコードプリセット定義
 *
 * config.yml の encode[].cmd から引数でエンコーダを切り替える。
 *   例: cmd: '%NODE% %ROOT%/config/enc.js hevc_nvenc 1080'
 * 第 1 引数: プリセット名 (省略時 h264)
 * 第 2 引数: 出力の最大高さ (省略時 720。0 を指定すると元解像度のまま)
 *
 * config.yml の encodePresets (§ ハードウェア × コーデック × 画質 × 用途の
 * 一括有効化フラグ) を使う場合、このプリセット名は自動的に選択されるため
 * 通常は意識しなくてよい。
 *
 * このプリセット表は「録画ファイルのバックグラウンドエンコード」用。リアルタイム性が
 * 不要 (時間をかけてよい) なので、速度より画質・圧縮効率を優先した速度プリセットにしている
 * (ライブ HLS・録画ストリーミングの低遅延チューニングは src/util/EncodePresets.ts 側)。
 * エンコードが遅すぎる場合は各プリセットの速度指定を速い側へ倒すこと
 * (libx264/libx265: -preset を medium/fast へ、NVENC: -preset p7 → p4、
 *  QSV: -preset slower → medium、rigaya 系: --quality / --preset を速い側へ)。
 *
 * 品質パラメータの目安:
 *   libx264/libx265 の -crf、NVENC の -cq、QSV の -global_quality、
 *   rigaya 系の --cqp は「小さいほど高画質・大きいほど高圧縮」。VAAPI の -qp も同様。
 *
 * ハードウェアデコードも使いたい場合は、-i の前に挿入するオプションを
 * 各自追加すること (NVENC: -hwaccel cuda / QSV: -hwaccel qsv)。
 * フィルタ構成 (yadif 等) の変更が必要になる場合がある。
 */
const PRESETS = {
    // AVC (H.264) ソフトウェアエンコード。-preset slow は veryfast より時間がかかる代わりに
    // 同じ -crf でもファイルサイズが小さくなる (圧縮効率が上がる)
    // -pix_fmt yuv420p / -profile:v high は iOS / Safari のハードウェアデコード互換のため
    h264: {
        codec: 'libx264',
        quality: ['-preset', 'slow', '-crf', '23', '-profile:v', 'high', '-pix_fmt', 'yuv420p'],
    },
    // HEVC (H.265) ソフトウェアエンコード。同画質で H.264 の約半分のサイズだが CPU 負荷は高い
    // -tag:v hvc1 は Safari / iOS / Apple 系プレイヤーでの再生に必須
    // -profile:v main + -pix_fmt yuv420p (8bit 4:2:0) も同様に必須。Main10 は端末世代によって再生できない
    // libx265 の medium は libx264 の slow と同程度の負荷なので、ここは medium で止めている
    hevc: {
        codec: 'libx265',
        quality: [
            '-preset', 'medium',
            '-crf', '25',
            '-profile:v', 'main',
            '-pix_fmt', 'yuv420p',
            '-tag:v', 'hvc1',
        ],
    },
    // AVC (NVIDIA NVENC)。-cq は -rc vbr かつ -b:v 0 のときに CRF 相当として機能する。
    // -preset p7 は NVENC で最も画質優先 (最も遅い) プリセット、-tune hq は画質重視のチューニング
    h264_nvenc: {
        codec: 'h264_nvenc',
        quality: ['-preset', 'p7', '-tune', 'hq', '-rc', 'vbr', '-cq', '26', '-b:v', '0', '-pix_fmt', 'yuv420p'],
    },
    // HEVC (NVIDIA NVENC)
    hevc_nvenc: {
        codec: 'hevc_nvenc',
        quality: [
            '-preset', 'p7',
            '-tune', 'hq',
            '-rc', 'vbr',
            '-cq', '28',
            '-b:v', '0',
            '-profile:v', 'main',
            '-tag:v', 'hvc1',
        ],
    },
    // AVC (Intel QSV)。-global_quality は ICQ モード。-preset slower は veryslow の 1 段手前
    // (veryslow は環境によって極端に遅くなることがあるため slower を採用)
    h264_qsv: {
        codec: 'h264_qsv',
        quality: ['-preset', 'slower', '-global_quality', '26'],
        needsNv12: true, // QSV はシステムメモリ入力の場合 nv12 を要求する
    },
    // HEVC (Intel QSV)
    hevc_qsv: {
        codec: 'hevc_qsv',
        quality: ['-preset', 'slower', '-global_quality', '28', '-profile:v', 'main', '-tag:v', 'hvc1'],
        needsNv12: true,
    },
    // AVC (AMD/Intel VAAPI)。-qp は固定量子化 (小さいほど高画質)
    // Linux + /dev/dri のアクセス権限が必要 (Docker では --device /dev/dri を渡すこと)
    h264_vaapi: {
        codec: 'h264_vaapi',
        quality: ['-qp', '24'],
        vaapi: true,
    },
    // HEVC (AMD/Intel VAAPI)
    hevc_vaapi: {
        codec: 'hevc_vaapi',
        quality: ['-qp', '26', '-profile:v', 'main', '-tag:v', 'hvc1'],
        vaapi: true,
    },

    // --- rigaya 系エンコーダ (QSVEncC / NVEncC / VCEEncC) ---
    // ffmpeg を経由せず rigaya 製エンコーダ単体でデコード〜エンコード〜mp4 出力まで行う。
    // 実行ファイルパスは config.yml の qsvencc / nvencc / vceencc を EncoderModel が
    // 環境変数 QSVENCC / NVENCC / VCEENCC として渡す (未設定時は PATH 上のコマンド名)。
    // 引数の大半は 3 ツール共通だが、速度プリセットの**オプション名と選べる値は異なる**:
    //   QSVEncC: --quality best|higher|high|balanced|fast|faster|fastest
    //   NVEncC:  --preset P1〜P7 (P7 = quality)
    //   VCEEncC: --preset balanced|fast|slow|slower  (quality という値は存在しない)
    // レート制御は背景エンコード向けに --cqp <I:P:B> (固定量子化 = 画質基準) を使う。
    //
    // HEVC の場合は rigaya 側で mp4 を書かず、mpegts を標準出力へ渡して ffmpeg で
    // -tag:v hvc1 を付けて mp4 化する (rigaya にはコーデックタグを指定する手段が無く、
    // 既定の hev1 タグのままだと iOS / Safari で再生できないため)。
    qsvencc_h264: { rigaya: 'qsvencc', rigayaCodec: 'h264', quality: ['--quality', 'best', '--cqp', '20:22:24'] },
    qsvencc_hevc: { rigaya: 'qsvencc', rigayaCodec: 'hevc', quality: ['--quality', 'best', '--cqp', '22:24:26'] },
    nvencc_h264: { rigaya: 'nvencc', rigayaCodec: 'h264', quality: ['--preset', 'P7', '--cqp', '20:22:24'] },
    nvencc_hevc: { rigaya: 'nvencc', rigayaCodec: 'hevc', quality: ['--preset', 'P7', '--cqp', '22:24:26'] },
    vceencc_h264: { rigaya: 'vceencc', rigayaCodec: 'h264', quality: ['--preset', 'slower', '--cqp', '20:22:24'] },
    vceencc_hevc: { rigaya: 'vceencc', rigayaCodec: 'hevc', quality: ['--preset', 'slower', '--cqp', '22:24:26'] },
};

const getHardwarePreset = (codec, encoder) => {
    if (!encoder) return null;
    const map = {
        h264_qsv: { codec: 'h264_qsv', quality: ['-preset', 'slower', '-global_quality', '26'], needsNv12: true },
        hevc_qsv: { codec: 'hevc_qsv', quality: ['-preset', 'slower', '-global_quality', '28', '-profile:v', 'main', '-tag:v', 'hvc1'], needsNv12: true },
        h264_nvenc: { codec: 'h264_nvenc', quality: ['-preset', 'p7', '-tune', 'hq', '-rc', 'vbr', '-cq', '26', '-b:v', '0', '-pix_fmt', 'yuv420p'] },
        hevc_nvenc: { codec: 'hevc_nvenc', quality: ['-preset', 'p7', '-tune', 'hq', '-rc', 'vbr', '-cq', '28', '-b:v', '0', '-profile:v', 'main', '-pix_fmt', 'yuv420p', '-tag:v', 'hvc1'] },
        h264_videotoolbox: { codec: 'h264_videotoolbox', quality: ['-b:v', '6M', '-realtime', '1', '-allow_sw', '0', '-pix_fmt', 'yuv420p', '-profile:v', 'high'] },
        hevc_videotoolbox: { codec: 'hevc_videotoolbox', quality: ['-b:v', '6M', '-realtime', '1', '-allow_sw', '0', '-pix_fmt', 'yuv420p', '-profile:v', 'main', '-tag:v', 'hvc1'] },
        h264_amf: { codec: 'h264_amf', quality: ['-quality', 'quality', '-rc', 'vbr_peak', '-qp_i', '24', '-qp_p', '26', '-pix_fmt', 'yuv420p'] },
        hevc_amf: { codec: 'hevc_amf', quality: ['-quality', 'quality', '-rc', 'vbr_peak', '-qp_i', '26', '-qp_p', '28', '-profile:v', 'main', '-pix_fmt', 'yuv420p', '-tag:v', 'hvc1'] },
        h264_vaapi: { codec: 'h264_vaapi', quality: ['-qp', '24'], vaapi: true },
        hevc_vaapi: { codec: 'hevc_vaapi', quality: ['-qp', '26', '-profile:v', 'main', '-tag:v', 'hvc1'], vaapi: true },
    };
    const preset = map[encoder];
    return preset && encoder.indexOf(codec + '_') === 0 ? preset : null;
};

/**
 * iOS / Safari のハードウェアデコーダで確実に再生できるプロファイル・レベルを返す
 * HEVC は Main (8bit 4:2:0) のみを使う (Main10 は端末世代によって再生できない)。
 * 地上波・BS/CS は元が 8bit なので Main で足りる
 * @param codec 'h264' | 'hevc'
 * @param height 出力の高さ (0 以下・NaN の場合は 1080 相当として扱う)
 * @return { profile: string, level: string }
 */
const getProfileAndLevel = (codec, height) => {
    const h = isNaN(height) === true || height <= 0 ? 1080 : height;

    if (codec === 'hevc') {
        return { profile: 'main', level: h >= 2160 ? '5.1' : h >= 1080 ? '4.1' : '4' };
    }

    return {
        profile: h >= 720 ? 'high' : 'main',
        level: h >= 2160 ? '5.2' : h >= 1080 ? '4.1' : h >= 720 ? '4' : h >= 480 ? '3.1' : '3',
    };
};

// rigaya 系エンコーダの既定コマンド名 (config.yml で実行ファイルパス未指定の場合に使う)
const RIGAYA_DEFAULT_BIN = {
    qsvencc: 'QSVEncC',
    nvencc: 'NVEncC',
    vceencc: 'VCEEncC',
};

const presetName = typeof process.argv[2] === 'undefined' ? 'h264' : process.argv[2];
const requestedPreset = PRESETS[presetName];
if (typeof requestedPreset === 'undefined') {
    console.error(`unknown encode preset: ${presetName} (available: ${Object.keys(PRESETS).join(', ')})`);
    process.exit(1);
}
const envEncoder = presetName === 'h264' ? process.env.HWENCODER_H264 : presetName === 'hevc' ? process.env.HWENCODER_HEVC : '';
const hardwarePreset = getHardwarePreset(presetName, envEncoder);
const hardwareRigayaPreset = PRESETS[envEncoder];
const selectedRigayaPreset = hardwareRigayaPreset && hardwareRigayaPreset.rigayaCodec === presetName ? hardwareRigayaPreset : null;
const preset = hardwarePreset || selectedRigayaPreset || requestedPreset;

const maxHeight = typeof process.argv[3] === 'undefined' ? 720 : parseInt(process.argv[3], 10);
const needsResize = maxHeight > 0 && isNaN(videoHeight) === false && videoHeight > maxHeight;

const getInputInfo = () => new Promise(resolve => {
    execFile(ffprobe, ['-v', '0', '-select_streams', 'v:0', '-show_frames', '-show_streams', '-read_intervals', '%+#1', '-of', 'json', input], (err, stdout) => {
        if (err) return resolve({ fieldOrder: null, colorTransfer: null, colorPrimaries: null });
        try {
            const result = JSON.parse(stdout);
            const stream = result.streams[0] || {};
            const frame = (result.frames || []).find(item => item.media_type === 'video' || item.stream_index === stream.index) || {};
            resolve({ fieldOrder: stream.field_order || null, colorPrimaries: stream.color_primaries || null,
                colorTransfer: frame.color_transfer || stream.color_transfer || null });
        } catch (_) {
            resolve({ fieldOrder: null, colorTransfer: null, colorPrimaries: null });
        }
    });
});

const getFilterNames = () => new Promise(resolve => {
    execFile(ffmpeg, ['-hide_banner', '-filters'], (err, stdout, stderr) => {
        const listing = `${stdout || ''}${stderr || ''}`;
        resolve(err ? '' : listing);
    });
});

const buildFfmpegArgs = (selectedPreset, inputInfo, filterListing) => {
    const result = ['-y', '-analyzeduration', analyzedurationSize, '-probesize', probesizeSize];
    if (isDualMono) Array.prototype.push.apply(result, ['-dual_mono_mode', dualMonoMode]);
    if (selectedPreset.vaapi === true) Array.prototype.push.apply(result, ['-vaapi_device', '/dev/dri/renderD128']);
    Array.prototype.push.apply(result, ['-i', input, '-movflags', 'faststart']);

    const filters = [];
    if (inputInfo.fieldOrder !== 'progressive') filters.push('yadif');
    const pq = inputInfo.colorTransfer === 'smpte2084';
    const bt2020 = (inputInfo.colorPrimaries || '').startsWith('bt2020');
    const compatibleTransfer =
        inputInfo.colorTransfer === 'arib-std-b67' || inputInfo.colorTransfer === 'smpte2084' || !inputInfo.colorTransfer
            ? 'bt2020-10'
            : inputInfo.colorTransfer;
    const colorspaceFilter = `colorspace=all=bt709:iall=bt2020:itrc=${compatibleTransfer}:fast=0:format=yuv420p`;
    const isEightBitOutput = selectedPreset.needsNv12 === true || selectedPreset.quality.some((value, index, list) => value === '-pix_fmt' && list[index + 1] === 'yuv420p');
    const colorConversion = isEightBitOutput && (inputInfo.colorTransfer === 'arib-std-b67' || (bt2020 && !pq));
    if (selectedPreset.vaapi === true) {
        if (isEightBitOutput && (colorConversion || pq)) {
            if (needsResize) filters.push(`scale=-2:${maxHeight}`);
            if (colorConversion) filters.push(colorspaceFilter);
            else if (pq && filterListing.includes(' zscale ') && filterListing.includes(' tonemap ')) {
                filters.push('zscale=t=linear:npl=100,format=gbrpf32le,tonemap=tonemap=hable:desat=0,zscale=p=bt709:t=bt709:m=bt709,format=yuv420p');
            } else if (pq) {
                console.error('color conversion: PQ compatible BT.2020-to-BT.709 path (zscale/tonemap unavailable)');
                filters.push(colorspaceFilter);
            }
        }
        filters.push('format=nv12', 'hwupload');
        if (inputInfo.fieldOrder !== 'progressive') filters.push('deinterlace_vaapi');
        if (needsResize && colorConversion === false && pq === false) filters.push(`scale_vaapi=-2:${maxHeight}`);
    } else {
        if (needsResize) filters.push(`scale=-2:${maxHeight}`);
        if (colorConversion) filters.push(colorspaceFilter);
        if (isEightBitOutput && pq && filterListing.includes(' zscale ') && filterListing.includes(' tonemap ')) {
            filters.push('zscale=t=linear:npl=100,format=gbrpf32le,tonemap=tonemap=hable:desat=0,zscale=p=bt709:t=bt709:m=bt709,format=yuv420p');
        } else if (isEightBitOutput && pq) {
            console.error('color conversion: PQ compatible BT.2020-to-BT.709 path (zscale/tonemap unavailable)');
            filters.push(colorspaceFilter);
        }
        if (selectedPreset.needsNv12 === true) filters.push('format=nv12');
    }
    if (filters.length > 0) Array.prototype.push.apply(result, ['-vf', filters.join(',')]);

    Array.prototype.push.apply(result, ['-aspect', '16:9', '-c:v', selectedPreset.codec]);
    if (selectedPreset.rigaya) {
        if (isEightBitOutput && (colorConversion || pq)) {
            console.error('color conversion skipped: rigaya path has no verified colorspace option; encoded pixels remain BT.2020');
        }
    } else if (isEightBitOutput && (colorConversion || pq)) {
        Array.prototype.push.apply(result, ['-color_primaries', 'bt709', '-color_trc', 'bt709', '-colorspace', 'bt709']);
    }
    Array.prototype.push.apply(result, selectedPreset.quality);
    Array.prototype.push.apply(result, ['-f', 'mp4', '-c:a', 'aac', '-ar', '48000', '-ab', audioBitrate, '-ac', '2', output]);
    return result;
};

/**
 * rigaya 系エンコーダ (QSVEncC / NVEncC / VCEEncC) の引数を組み立てる
 * @param preset プリセット定義 (rigaya / rigayaCodec を持つもの)
 * @return string[] エンコーダに渡す引数
 */
const buildRigayaArgs = (preset, inputInfo) => {
    // 出力の高さ (リサイズしない場合は元解像度)
    const outputHeight = needsResize ? maxHeight : videoHeight;
    const { profile, level } = getProfileAndLevel(preset.rigayaCodec, outputHeight);

    const rigayaArgs = [
        // ハードウェアデコード + ハードウェアエンコード
        '--avhw',
        '-i', input,
        '-c', preset.rigayaCodec,
        // iOS / Safari 互換のプロファイル・レベル・ビット深度
        '--profile', profile,
        '--level', level,
        '--output-depth', '8',
        // 録画済みファイルの保存用途なので GOP は 2 秒 (@30fps) にして圧縮効率を優先する
        '--gop-len', '60',
    ];
    if (inputInfo.fieldOrder !== 'progressive') Array.prototype.push.apply(rigayaArgs, ['--interlace', 'tff']);

    // 速度プリセット + レート制御 (ツールごとにオプション名・値が違うため PRESETS 側で持つ)
    Array.prototype.push.apply(rigayaArgs, preset.quality);

    // デインタレース
    // --vpp-deinterlace (ハードウェアデインタレーサ) は QSVEncC / NVEncC のみのオプションで、
    // かつ --interlace tff/bff の指定が前提。VCEEncC には無いため共通オプションの --vpp-yadif を使う
    if (inputInfo.fieldOrder !== 'progressive') {
        if (preset.rigaya === 'vceencc') {
            rigayaArgs.push('--vpp-yadif');
        } else {
            Array.prototype.push.apply(rigayaArgs, ['--vpp-deinterlace', 'normal']);
        }
    }

    // リサイズ (幅は -2 = アスペクト比を保ったまま 2 の倍数へ丸める)
    if (needsResize) {
        Array.prototype.push.apply(rigayaArgs, ['--output-res', `-2x${maxHeight}`]);
    }

    // 音声設定
    Array.prototype.push.apply(rigayaArgs, ['--audio-codec', 'aac', '--audio-bitrate', audioBitrate.replace('k', '')]);
    if (isDualMono) {
        // dual mono は主音声 (左チャンネル) を両チャンネルへ複製する (ffmpeg の -dual_mono_mode main 相当)。
        // `:stereo` だと単にステレオ化されるだけで左右に主音声・副音声が残ってしまう
        Array.prototype.push.apply(rigayaArgs, ['--audio-stream', 'FL:stereo']);
    }

    // 出力設定
    // HEVC は hvc1 タグを付けるため ffmpeg へ mpegts で受け渡す (needsHvc1Remux 参照)
    if (needsHvc1Remux(preset)) {
        Array.prototype.push.apply(rigayaArgs, ['--output-format', 'mpegts', '-o', '-']);
    } else {
        Array.prototype.push.apply(rigayaArgs, ['--output-format', 'mp4', '-o', output]);
    }

    return rigayaArgs;
};

/**
 * rigaya 系エンコーダの出力を ffmpeg で hvc1 タグ付き mp4 へ remux する必要があるか
 * rigaya 系エンコーダには mp4 のコーデックタグを指定するオプションが無く、
 * 既定の hev1 タグのままだと iOS / Safari で再生できない
 * @param preset プリセット定義
 * @return boolean
 */
function needsHvc1Remux(preset) {
    return typeof preset.rigaya !== 'undefined' && preset.rigayaCodec === 'hevc';
}

/**
 * rigaya 系エンコーダ (mpegts を標準出力へ) を受けて mp4 へ remux する ffmpeg の引数
 * 映像・音声とも rigaya 側でエンコード済みなので copy でよい
 * @return string[]
 */
const buildHvc1RemuxArgs = () => [
    '-y',
    '-fflags', '+genpts',
    '-f', 'mpegts',
    '-i', 'pipe:0',
    '-c', 'copy',
    // iOS / Safari で HEVC を再生するために必須のコーデックタグ
    '-tag:v', 'hvc1',
    '-movflags', 'faststart',
    '-f', 'mp4',
    output,
];

/**
 * 引数付きのコマンドライン文字列を組み立てる (ログ出力用)
 * @param bin 実行ファイル
 * @param execArgs 引数
 * @return string
 */
const toCommandLine = (bin, execArgs) => {
    let str = bin;
    for (let i of execArgs) {
        str += ` ${ i }`
    }

    return str;
};

// rigaya 系プリセットの場合は ffmpeg ではなく rigaya 製エンコーダを実行する
const isRigaya = typeof preset.rigaya !== 'undefined';
const bin = isRigaya ? (process.env[preset.rigaya.toUpperCase()] || RIGAYA_DEFAULT_BIN[preset.rigaya]) : ffmpeg;
const runEncoder = (execBin, execArgs) => new Promise(resolve => {
    console.error(toCommandLine(execBin, execArgs));
    const child = spawn(execBin, execArgs);
    child.stderr.on('data', data => console.error(String(data)));
    child.on('error', err => {
        console.error(err);
        resolve(1);
    });
    child.on('close', code => resolve(code === null ? 1 : code));
    process.on('SIGINT', () => child.kill('SIGINT'));
});

const runRigayaEncoder = async (rigayaPreset, inputInfo) => {
    const rigayaArgs = buildRigayaArgs(rigayaPreset, inputInfo);
    if (!needsHvc1Remux(rigayaPreset)) return runEncoder(bin, rigayaArgs);

    const remuxArgs = buildHvc1RemuxArgs();
    console.error(toCommandLine(ffmpeg, remuxArgs));
    const remux = spawn(ffmpeg, remuxArgs);
    const encoder = spawn(bin, rigayaArgs);
    remux.stderr.on('data', data => console.error(String(data)));
    encoder.stderr.on('data', data => console.error(String(data)));
    encoder.stdout.pipe(remux.stdin);
    process.on('SIGINT', () => { encoder.kill('SIGINT'); remux.kill('SIGINT'); });

    const encoderExit = new Promise(resolve => {
        encoder.on('error', err => { console.error(err); remux.kill('SIGINT'); resolve(1); });
        encoder.on('close', code => resolve(code === null ? 1 : code));
    });
    const remuxExit = new Promise(resolve => {
        remux.on('error', err => { console.error(err); encoder.kill('SIGINT'); resolve(1); });
        remux.on('close', code => resolve(code === null ? 1 : code));
    });
    const [encoderCode, remuxCode] = await Promise.all([encoderExit, remuxExit]);
    return encoderCode === 0 ? remuxCode : encoderCode;
};

(async () => {
    try {
        const [inputInfo, filterListing] = await Promise.all([getInputInfo(), getFilterNames()]);
        if (isRigaya) {
            if ((inputInfo.colorPrimaries || '').startsWith('bt2020') && preset.rigayaCodec === 'h264') {
                console.error('color conversion skipped: rigaya path has no verified colorspace option; encoded pixels remain BT.2020');
            }
            let code = await runRigayaEncoder(preset, inputInfo);
            if (selectedRigayaPreset && code !== 0) {
                console.error(`hardware encoder ${selectedRigayaPreset.rigaya} failed (${code}); retrying with software`);
                code = await runEncoder(ffmpeg, buildFfmpegArgs(PRESETS[presetName], inputInfo, filterListing));
            }
            process.exitCode = code;
            return;
        }

        const execArgs = buildFfmpegArgs(preset, inputInfo, filterListing);
        let code = await runEncoder(ffmpeg, execArgs);
        if (hardwarePreset && code !== 0) {
            console.error(`hardware encoder ${hardwarePreset.codec} failed (${code}); retrying with software`);
            code = await runEncoder(ffmpeg, buildFfmpegArgs(PRESETS[presetName], inputInfo, filterListing));
        }
        process.exitCode = code;
    } catch (err) {
        console.error(err);
        process.exitCode = 1;
    }
})();
