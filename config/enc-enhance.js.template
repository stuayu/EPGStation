const spawn = require('child_process').spawn;
const execFile = require('child_process').execFile;
const ffmpeg = process.env.FFMPEG;
const ffprobe = process.env.FFPROBE;

const input = process.env.INPUT;
const output = process.env.OUTPUT;
const isDualMono = parseInt(process.env.AUDIOCOMPONENTTYPE, 10) == 2;
const args = ['-y'];

/**
 * 動画長取得関数
 * @param {string} filePath ファイルパス
 * @return number 動画長を返す (秒)
 */
const getDuration = filePath => {
    return new Promise((resolve, reject) => {
        execFile(ffprobe, ['-v', '0', '-show_format', '-of', 'json', filePath], (err, stdout) => {
            if (err) {
                reject(err);

                return;
            }

            try {
                const result = JSON.parse(stdout);
                resolve(parseFloat(result.format.duration));
            } catch (err) {
                reject(err);
            }
        });
    });
};

const getVideoInfo = () => new Promise(resolve => {
    execFile(ffprobe, ['-v', '0', '-select_streams', 'v:0', '-show_streams', '-show_frames', '-read_intervals', '%+#1', '-of', 'json', input], (err, stdout) => {
        try {
            const result = err ? {} : JSON.parse(stdout);
            const stream = (result.streams || [])[0] || {};
            const frame = (result.frames || []).find(item => item.media_type === 'video' || item.stream_index === stream.index) || {};
            resolve({ fieldOrder: stream.field_order || null, colorPrimaries: stream.color_primaries || null,
                colorTransfer: frame.color_transfer || stream.color_transfer || null });
        } catch (_) {
            resolve({ fieldOrder: null, colorTransfer: null, colorPrimaries: null });
        }
    });
});

const getFilterListing = () => new Promise(resolve => {
    execFile(ffmpeg, ['-hide_banner', '-filters'], (err, stdout, stderr) => resolve(err ? '' : `${stdout || ''}${stderr || ''}`));
});

const buildArgs = (codec, info, filterListing) => {
    const result = args.slice();
    Array.prototype.push.apply(result, ['-fix_sub_duration', '-i', input, '-map', '0:v', '-c:v', codec]);
    const filters = [];
    if (info.fieldOrder !== 'progressive') filters.push('yadif');
    const pq = info.colorTransfer === 'smpte2084';
    const bt2020 = (info.colorPrimaries || '').startsWith('bt2020');
    const compatibleTransfer =
        info.colorTransfer === 'arib-std-b67' || info.colorTransfer === 'smpte2084' || !info.colorTransfer
            ? 'bt2020-10'
            : info.colorTransfer;
    const colorspaceFilter = `colorspace=all=bt709:iall=bt2020:itrc=${compatibleTransfer}:fast=0:format=yuv420p`;
    if (info.colorTransfer === 'arib-std-b67' || (bt2020 && !pq)) {
        filters.push(colorspaceFilter);
    } else if (pq && filterListing.includes(' zscale ') && filterListing.includes(' tonemap ')) {
        filters.push('zscale=t=linear:npl=100,format=gbrpf32le,tonemap=tonemap=hable:desat=0,zscale=p=bt709:t=bt709:m=bt709,format=yuv420p');
    } else if (pq) {
        console.error('color conversion: PQ compatible BT.2020-to-BT.709 path (zscale/tonemap unavailable)');
        filters.push(colorspaceFilter);
    }
    if (codec === 'h264_qsv') filters.push('format=nv12');
    if (filters.length) Array.prototype.push.apply(result, ['-vf', filters.join(',')]);
    if (isDualMono) {
        Array.prototype.push.apply(result, ['-filter_complex', 'channelsplit[FL][FR]', '-map', '[FL]', '-map', '[FR]', '-metadata:s:a:0', 'language=jpn', '-metadata:s:a:1', 'language=eng']);
    } else {
        Array.prototype.push.apply(result, ['-map', '0:a']);
    }
    Array.prototype.push.apply(result, ['-c:a', 'aac']);
    Array.prototype.push.apply(result, ['-map', '0:s?', '-c:s', 'mov_text']);
    if ((bt2020 || info.colorTransfer === 'arib-std-b67' || pq) && /(?:h264|x264|avc)/i.test(codec)) {
        Array.prototype.push.apply(result, ['-color_primaries', 'bt709', '-color_trc', 'bt709', '-colorspace', 'bt709']);
    }
    if (codec === 'h264_videotoolbox') Array.prototype.push.apply(result, ['-b:v', '6M', '-realtime', '1', '-allow_sw', '1', '-pix_fmt', 'yuv420p', '-profile:v', 'high']);
    else if (codec === 'h264_qsv') Array.prototype.push.apply(result, ['-preset', 'veryfast', '-global_quality', '26']);
    else if (codec === 'h264_nvenc') Array.prototype.push.apply(result, ['-preset', 'p4', '-rc', 'vbr', '-cq', '26', '-b:v', '0', '-pix_fmt', 'yuv420p']);
    else if (codec === 'h264_amf') Array.prototype.push.apply(result, ['-quality', 'speed', '-rc', 'vbr_peak', '-qp_i', '24', '-qp_p', '26', '-pix_fmt', 'yuv420p']);
    else Array.prototype.push.apply(result, ['-preset', 'veryfast', '-crf', '26', '-pix_fmt', 'yuv420p']);
    Array.prototype.push.apply(result, [output]);
    return result;
};

(async () => {
    // 進捗計算のために動画の長さを取得
    const duration = await getDuration(input);

    const [info, filterListing] = await Promise.all([getVideoInfo(), getFilterListing()]);
    const hwEncoder = process.env.HWENCODER_H264;
    const codec = ['h264_qsv', 'h264_nvenc', 'h264_amf', 'h264_videotoolbox'].includes(hwEncoder) ? hwEncoder : 'libx264';
    let child = spawn(ffmpeg, buildArgs(codec, info, filterListing));

    /**
     * エンコード進捗表示用に標準出力に進捗情報を吐き出す
     * 出力する JSON
     * {"type":"progress","percent": 0.8, "log": "view log" }
     */
    child.stderr.on('data', data => {
        let strbyline = String(data).split('\n');
        for (let i = 0; i < strbyline.length; i++) {
            let str = strbyline[i];
            if (str.startsWith('frame')) {
                // 想定log
                // frame= 5159 fps= 11 q=29.0 size=  122624kB time=00:02:51.84 bitrate=5845.8kbits/s dup=19 drop=0 speed=0.372x
                const progress = {};
                const ffmpeg_reg = /frame=\s*(?<frame>\d+)\sfps=\s*(?<fps>\d+(?:\.\d+)?)\sq=\s*(?<q>[+-]?\d+(?:\.\d+)?)\sL?size=\s*(?<size>\d+(?:\.\d+)?)kB\stime=\s*(?<time>\d+[:\.\d+]*)\sbitrate=\s*(?<bitrate>\d+(?:\.\d+)?)kbits\/s(?:\sdup=\s*(?<dup>\d+))?(?:\sdrop=\s*(?<drop>\d+))?\sspeed=\s*(?<speed>\d+(?:\.\d+)?)x/;
                let ffmatch =str.match(ffmpeg_reg);
                /**
                 * match結果
                 * [
                 *   'frame= 5159 fps= 11 q=29.0 size=  122624kB time=00:02:51.84 bitrate=5845.8kbits/s dup=19 drop=0 speed=0.372x',
                 *   '5159',
                 *   '11',
                 *   '29.0',
                 *   '122624',
                 *   '00:02:51.84',
                 *   '5845.8',
                 *   '19',
                 *   '0',
                 *   '0.372',
                 *   index: 0,
                 *   input: 'frame= 5159 fps= 11 q=29.0 size=  122624kB time=00:02:51.84 bitrate=5845.8kbits/s dup=19 drop=0 speed=0.372x    \r',
                 *   groups: [Object: null prototype] {
                 *     frame: '5159',
                 *     fps: '11',
                 *     q: '29.0',
                 *     size: '122624',
                 *     time: '00:02:51.84',
                 *     bitrate: '5845.8',
                 *     dup: '19',
                 *     drop: '0',
                 *     speed: '0.372'
                 *   }
                 * ]
                 */

                if (ffmatch === null) continue;

                progress['frame'] = parseInt(ffmatch.groups.frame);
                progress['fps'] = parseFloat(ffmatch.groups.fps);
                progress['q'] = parseFloat(ffmatch.groups.q);
                progress['size'] = parseInt(ffmatch.groups.size);
                progress['time'] = ffmatch.groups.time;
                progress['bitrate'] = parseFloat(ffmatch.groups.bitrate);
                progress['dup'] = ffmatch.groups.dup == null ? 0 : parseInt(ffmatch.groups.dup);
                progress['drop'] = ffmatch.groups.drop == null ? 0 : parseInt(ffmatch.groups.drop);
                progress['speed'] = parseFloat(ffmatch.groups.speed);

                let current = 0;
                const times = progress.time.split(':');
                for (let i = 0; i < times.length; i++) {
                    if (i == 0) {
                        current += parseFloat(times[i]) * 3600;
                    } else if (i == 1) {
                        current += parseFloat(times[i]) * 60;
                    } else if (i == 2) {
                        current += parseFloat(times[i]);
                    }
                }

                // 進捗率 1.0 で 100%
                const percent = current / duration;
                const log =
                    'frame= ' +
                    progress.frame +
                    ' fps=' +
                    progress.fps +
                    ' size=' +
                    progress.size +
                    ' time=' +
                    progress.time +
                    ' bitrate=' +
                    progress.bitrate +
                    ' drop=' +
                    progress.drop +
                    ' speed=' +
                    progress.speed;

                console.log(JSON.stringify({ type: 'progress', percent: percent, log: log }));
            }
        }
    });

    child.on('error', err => {
        console.error(err);
        throw new Error(err);
    });

    child.on('close', code => {
        if (code !== 0 && codec !== 'libx264') {
            console.error(`hardware encoder ${codec} failed (${code}); retrying with software`);
            child = spawn(ffmpeg, buildArgs('libx264', info, filterListing));
            child.stderr.on('data', data => console.error(String(data)));
            child.on('close', softwareCode => { process.exitCode = softwareCode; });
            child.on('error', err => { console.error(err); process.exitCode = 1; });
            return;
        }
        process.exitCode = code;
    });

    process.on('SIGINT', () => {
        child.kill('SIGINT');
    });
})();
