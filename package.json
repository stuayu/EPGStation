{
    "name": "epgstation",
    "version": "2.14.0-stuayu",
    "description": "DTV Software in Japan.",
    "main": "dist/index.js",
    "scripts": {
        "all-install": "npm i --no-save && cd client && npm i --no-save",
        "start": "node dist/index.js",
        "build": "npm run build-server && npm run build-client",
        "build-win": "npm run build-server && npm run build-client-win",
        "build-server": "npm run lint && npm run format && npm run compile",
        "build-client": "cd client && npm run build",
        "build-client-win": "cd client && npm run build-win",
        "lint": "eslint --fix src/",
        "format": "prettier --check --write \"src/**/*.ts\"",
        "clean": "node scripts/clean-dist.js",
        "compile": "npm run clean && tsc",
        "watch": "tsc --watch",
        "orm-gen": "typeorm migration:generate src/db/migrations/${npm_config_db}/${npm_config_name} -d ./ormconfig.js",
        "orm-run": "typeorm migration:run -d ./ormconfig.js",
        "backup": "node dist/DBTools.js -m backup -o",
        "restore": "node dist/DBTools.js -m restore -o",
        "v1migrate": "node dist/V1MigrationTool.js -i",
        "recover-channel-name": "node dist/RecoverChannelNameTool.js",
        "analyze-series": "node dist/SeriesAnalyzeTool.js",
        "install-win-service": "node scripts/win-service.js install",
        "uninstall-win-service": "node scripts/win-service.js uninstall",
        "status-win-service": "node scripts/win-service.js status",
        "test": "npm run test:ut && npm run test:ita",
        "test:ut": "npm run compile && node --experimental-test-coverage --test --test-coverage-lines=80 test/ut/*.test.js",
        "test:ita": "npm run compile && node --test test/ita/*.test.js",
        "test:itb": "npm run compile && node --test test/itb/*.test.js",
        "test:ci": "npm run test:ut && npm run test:ita && npm run test:itb"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/l3tnun/EPGStation-V2.git"
    },
    "author": "l3tnun",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/l3tnun/EPGStation-V2/issues"
    },
    "homepage": "https://github.com/l3tnun/EPGStation-V2#readme",
    "dependencies": {
        "arib-subtitle-timedmetadater": "4.0.10",
        "aribts": "2.1.12",
        "axios": "1.18.1",
        "better-sqlite3": "12.11.1",
        "cors": "2.8.6",
        "diskusage-ng": "1.0.4",
        "eventsource": "4.1.0",
        "express": "5.2.1",
        "express-openapi": "12.1.3",
        "fast-xml-parser": "5.10.1",
        "file-type": "22.0.1",
        "inversify": "6.0.2",
        "js-yaml": "5.2.2",
        "lodash": "4.18.1",
        "log4js": "6.9.1",
        "minimist": "1.2.8",
        "mirakurun": "git+https://github.com/stuayu/Mirakurun.git#4.2.0-stuayu",
        "mkdirp": "3.0.1",
        "multer": "2.2.0",
        "mysql2": "3.23.1",
        "openapi-types": "12.1.3",
        "reflect-metadata": "0.2.2",
        "socket.io": "4.8.3",
        "source-map-support": "0.5.21",
        "swagger-ui-dist": "5.32.11",
        "typeorm": "1.1.0",
        "url-join": "4.0.1",
        "web-bml": "github:tsukumijima/web-bml#fea69f4526ee4acc66687019a1985643618be572",
        "ws": "8.21.1"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@types/express": "5.0.6",
        "@types/lodash": "4.17.24",
        "@types/minimist": "1.2.5",
        "@types/multer": "2.2.0",
        "@types/node": "26.1.1",
        "@types/serve-static": "2.2.0",
        "@types/source-map-support": "0.5.10",
        "@types/url-join": "4.0.3",
        "@types/ws": "8.18.1",
        "eslint": "10.8.0",
        "eslint-config-prettier": "10.1.8",
        "globals": "17.7.0",
        "prettier": "3.9.6",
        "typescript": "6.0.3",
        "typescript-eslint": "8.65.0"
    },
    "overrides": {
        "express-openapi": {
            "glob": "^7.0.0"
        },
        "uuid": "^11.1.1"
    },
    "engines": {
        "node": ">=24 <25",
        "npm": ">=11 <12"
    },
    "allowScripts": {
        "better-sqlite3@12.11.1": true,
        "core-js": false,
        "@scarf/scarf": false
    }
}
